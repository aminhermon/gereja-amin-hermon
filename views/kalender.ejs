<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Kalender Kegiatan <%= general.churchName %> — Jadwal ibadah, acara, dan kegiatan gereja.">
  <title>Kalender Kegiatan — <%= general.churchName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="css/style.min.css?v=16">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
  <style>
    /* Embedded Calendar Modal Styles — immune to CSS cache/minification issues */
    .cal-modal {
      position: fixed !important;
      inset: 0 !important;
      z-index: 999999 !important;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .cal-modal.active {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }
    .cal-modal__backdrop {
      position: absolute !important;
      inset: 0 !important;
      background: rgba(5, 10, 20, 0.82) !important;
      backdrop-filter: blur(10px) !important;
      -webkit-backdrop-filter: blur(10px) !important;
      cursor: pointer;
    }
    .cal-modal__dialog {
      position: relative !important;
      width: 100% !important;
      max-width: 520px !important;
      max-height: 85vh !important;
      display: flex !important;
      flex-direction: column !important;
      background: #0E1826 !important;
      border: 1px solid rgba(200, 169, 81, 0.4) !important;
      border-radius: 20px !important;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(200, 169, 81, 0.25) !important;
      z-index: 100 !important;
      overflow: hidden !important;
      transform: scale(0.92) translateY(20px);
      transition: transform 0.35s ease;
    }
    .cal-modal.active .cal-modal__dialog {
      transform: scale(1) translateY(0) !important;
    }
    .cal-modal__close {
      position: absolute !important;
      top: 1rem !important;
      right: 1rem !important;
      width: 36px !important;
      height: 36px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      border-radius: 50% !important;
      background: rgba(255, 255, 255, 0.08) !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      color: #fff !important;
      font-size: 1.4rem !important;
      line-height: 1 !important;
      cursor: pointer !important;
      transition: all 0.2s ease !important;
      z-index: 105 !important;
    }
    .cal-modal__close:hover {
      background: #C8A951 !important;
      color: #0B1320 !important;
      transform: rotate(90deg) !important;
    }
    .cal-modal__header {
      display: flex !important;
      align-items: center !important;
      gap: 1rem !important;
      padding: 1.75rem 1.75rem 1.25rem !important;
      background: linear-gradient(180deg, rgba(200, 169, 81, 0.18) 0%, rgba(200, 169, 81, 0) 100%) !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    }
    .cal-modal__icon {
      width: 48px !important;
      height: 48px !important;
      min-width: 48px !important;
      border-radius: 12px !important;
      background: linear-gradient(135deg, rgba(200, 169, 81, 0.3) 0%, rgba(200, 169, 81, 0.1) 100%) !important;
      border: 1px solid #C8A951 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #C8A951 !important;
    }
    .cal-modal__subtitle {
      display: block !important;
      font-size: 0.75rem !important;
      font-weight: 700 !important;
      text-transform: uppercase !important;
      letter-spacing: 1.5px !important;
      color: #C8A951 !important;
      margin-bottom: 2px !important;
    }
    .cal-modal__title {
      font-family: inherit !important;
      font-size: 1.25rem !important;
      font-weight: 700 !important;
      color: #FFFFFF !important;
      margin: 0 !important;
      line-height: 1.3 !important;
    }
    .cal-modal__body {
      padding: 1.5rem 1.75rem !important;
      overflow-y: auto !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 1rem !important;
      max-height: calc(85vh - 170px) !important;
    }
    .cal-modal-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%) !important;
      border: 1px solid rgba(200, 169, 81, 0.25) !important;
      border-radius: 14px !important;
      padding: 1.25rem !important;
      transition: all 0.3s ease !important;
    }
    .cal-modal-card:hover {
      border-color: rgba(200, 169, 81, 0.5) !important;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35) !important;
    }
    .cal-modal-card__header {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      margin-bottom: 0.6rem !important;
      flex-wrap: wrap !important;
      gap: 6px !important;
    }
    .cal-modal-card__badge {
      font-size: 0.72rem !important;
      font-weight: 700 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.8px !important;
      color: #C8A951 !important;
      background: rgba(200, 169, 81, 0.18) !important;
      border: 1px solid rgba(200, 169, 81, 0.35) !important;
      padding: 3px 10px !important;
      border-radius: 20px !important;
    }
    .cal-modal-card__title {
      font-size: 1.1rem !important;
      font-weight: 700 !important;
      color: #FFFFFF !important;
      margin: 0 0 0.4rem 0 !important;
    }
    .cal-modal-card__desc {
      font-size: 0.9rem !important;
      color: #94A3B8 !important;
      line-height: 1.55 !important;
      margin: 0 !important;
    }
    .cal-modal-empty {
      text-align: center !important;
      padding: 2.5rem 1rem !important;
      color: #94A3B8 !important;
    }
    .cal-modal-empty__icon { font-size: 3rem !important; margin-bottom: 0.75rem !important; }
    .cal-modal-empty h4 { font-size: 1.1rem !important; color: #FFFFFF !important; margin-bottom: 0.35rem !important; }
    .cal-modal-empty p { font-size: 0.85rem !important; max-width: 320px !important; margin: 0 auto !important; }
    .cal-modal__footer {
      padding: 1rem 1.75rem 1.5rem !important;
      border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
      display: flex !important;
      justify-content: flex-end !important;
    }
    .cal-cell { cursor: pointer !important; }
  </style>
</head>
<body>

  <%- include('partials/skeleton') %>
  <%- include('partials/navbar') %>

  <!-- ========== HERO ========== -->
  <section class="hero hero--mini" id="hero-kalender">
    <div class="hero__bg">
      <img src="assets/images/church-hero-new.jpg" alt="Kalender Kegiatan" loading="eager">
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1>Kalender <span class="text-gold">Kegiatan</span></h1>
      <p class="hero__subtitle">Jadwal ibadah, acara, dan kegiatan Gereja AMIN Hermon.</p>
    </div>
  </section>

  <!-- ========== CALENDAR SECTION ========== -->
  <section class="section section--navy" id="kalender-section">
    <div class="container">

      <!-- Calendar Navigation -->
      <div class="cal-nav">
        <button class="cal-nav__btn" id="calPrev" aria-label="Bulan sebelumnya">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <h2 class="cal-nav__title" id="calTitle"></h2>
        <button class="cal-nav__btn" id="calNext" aria-label="Bulan berikutnya">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
        </button>
      </div>

      <!-- Calendar Grid -->
      <div class="cal-grid">
        <div class="cal-grid__header">
          <span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
        </div>
        <div class="cal-grid__body" id="calBody"></div>
      </div>

      <!-- Event Detail Panel -->
      <div class="cal-events" id="calEvents">
        <h3 class="cal-events__title" id="calEventsTitle">Pilih tanggal untuk melihat kegiatan</h3>
        <div class="cal-events__list" id="calEventsList"></div>
      </div>

      <!-- Upcoming Events -->
      <div class="cal-upcoming">
        <div class="section-header">
          <h2>Kegiatan <span class="text-gold">Mendatang</span></h2>
          <span class="gold-line"></span>
        </div>
        <div class="cal-upcoming__grid">
          <% kalender.sort(function(a,b){ return new Date(a.tanggal) - new Date(b.tanggal); }).forEach(function(ev) { %>
          <% if (new Date(ev.tanggal) >= new Date(new Date().toISOString().split('T')[0])) { %>
          <div class="cal-upcoming__card" data-event-date="<%= ev.tanggal %>" onclick="window.openCalendarModalDirect('<%= ev.tanggal %>')">
            <div class="cal-upcoming__date">
              <span class="cal-upcoming__day"><%= new Date(ev.tanggal).getDate() %></span>
              <span class="cal-upcoming__month"><%= ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agt','Sep','Okt','Nov','Des'][new Date(ev.tanggal).getMonth()] %></span>
            </div>
            <div class="cal-upcoming__info">
              <span class="cal-upcoming__badge"><%= ev.kategori %></span>
              <h4><%= ev.judul %></h4>
              <p><%= ev.desc %></p>
            </div>
          </div>
          <% } %>
          <% }); %>
        </div>
      </div>

    </div>
  </section>

  <!-- ========== CALENDAR EVENT MODAL OVERLAY ========== -->
  <div class="cal-modal" id="calModal" role="dialog" aria-modal="true" aria-labelledby="calModalDate">
    <div class="cal-modal__backdrop" onclick="window.closeCalModal()"></div>
    <div class="cal-modal__dialog">
      <button type="button" class="cal-modal__close" onclick="window.closeCalModal()" aria-label="Tutup popup">&times;</button>
      <div class="cal-modal__header">
        <div class="cal-modal__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div>
          <span class="cal-modal__subtitle">Agenda Kegiatan</span>
          <h3 class="cal-modal__title" id="calModalDate">Tanggal</h3>
        </div>
      </div>
      <div class="cal-modal__body" id="calModalBody"></div>
      <div class="cal-modal__footer">
        <button type="button" class="btn btn--gold btn--sm" onclick="window.closeCalModal()">Tutup</button>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="js/main.min.js?v=6" defer></script>
  <script>
    var calendarEvents = <%- JSON.stringify(kalender || []) %>;
    var MONTHS_ID = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    var DAYS_ID = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
    var currentYear, currentMonth;

    function initInteractiveCalendar() {
      var now = new Date();
      currentYear = now.getFullYear();
      currentMonth = now.getMonth();
      renderCalendar();

      var prevBtn = document.getElementById('calPrev');
      var nextBtn = document.getElementById('calNext');
      if (prevBtn) prevBtn.onclick = function() { currentMonth--; if (currentMonth < 0) { currentMonth = 11; currentYear--; } renderCalendar(); };
      if (nextBtn) nextBtn.onclick = function() { currentMonth++; if (currentMonth > 11) { currentMonth = 0; currentYear++; } renderCalendar(); };
    }

    function handleCellClick(dateStr) {
      var dayEvents = calendarEvents.filter(function(ev) { return ev.tanggal === dateStr; });
      openCalendarModal(dateStr, dayEvents);
    }

    function renderCalendar() {
      var titleEl = document.getElementById('calTitle');
      if (titleEl) titleEl.textContent = MONTHS_ID[currentMonth] + ' ' + currentYear;
      var body = document.getElementById('calBody');
      if (!body) return;
      body.innerHTML = '';

      var firstDay = new Date(currentYear, currentMonth, 1).getDay();
      var daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      var today = new Date();

      for (var i = 0; i < firstDay; i++) {
        var empty = document.createElement('div');
        empty.className = 'cal-cell cal-cell--empty';
        body.appendChild(empty);
      }

      for (var d = 1; d <= daysInMonth; d++) {
        var dateStr = currentYear + '-' + String(currentMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
        var dayEvents = calendarEvents.filter(function(e) { return e.tanggal === dateStr; });
        var isToday = (today.getFullYear() === currentYear && today.getMonth() === currentMonth && today.getDate() === d);

        var cell = document.createElement('div');
        cell.className = 'cal-cell' + (isToday ? ' cal-cell--today' : '') + (dayEvents.length ? ' cal-cell--has-event' : '');
        cell.setAttribute('data-date', dateStr);
        cell.innerHTML = '<span class="cal-cell__num">' + d + '</span>' + (dayEvents.length ? '<span class="cal-cell__dot"></span>' : '');

        // Direct onclick per cell — bulletproof, no event delegation needed
        (function(ds) {
          cell.onclick = function() { handleCellClick(ds); };
        })(dateStr);

        body.appendChild(cell);
      }
    }

    function openCalendarModal(dateStr, events) {
      if (!dateStr) return;
      var parts = dateStr.split('-');
      var y = parseInt(parts[0]); var m = parseInt(parts[1]) - 1; var d = parseInt(parts[2]);
      var dateObj = new Date(y, m, d);
      var formattedTitle = DAYS_ID[dateObj.getDay()] + ', ' + d + ' ' + MONTHS_ID[m] + ' ' + y;

      var titleModal = document.getElementById('calModalDate');
      if (titleModal) titleModal.textContent = formattedTitle;

      var modalBody = document.getElementById('calModalBody');
      if (modalBody) {
        if (events && events.length > 0) {
          modalBody.innerHTML = events.map(function(ev) {
            return '<div class="cal-modal-card"><div class="cal-modal-card__header"><span class="cal-modal-card__badge">' + (ev.kategori || 'Kegiatan') + '</span></div><h4 class="cal-modal-card__title">' + ev.judul + '</h4><p class="cal-modal-card__desc">' + (ev.desc || '') + '</p></div>';
          }).join('');
        } else {
          modalBody.innerHTML = '<div class="cal-modal-empty"><div class="cal-modal-empty__icon">&#128197;</div><h4>Tidak Ada Agenda</h4><p>Belum ada jadwal kegiatan khusus pada tanggal ini.</p></div>';
        }
      }

      showEventsInline(dateStr, events);

      var modal = document.getElementById('calModal');
      if (modal) {
        modal.style.display = 'flex';
        void modal.offsetHeight;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function openCalendarModalDirect(dateStr) {
      var dayEvents = calendarEvents.filter(function(e) { return e.tanggal === dateStr; });
      openCalendarModal(dateStr, dayEvents);
    }

    function closeCalModal() {
      var modal = document.getElementById('calModal');
      if (modal) {
        modal.classList.remove('active');
        setTimeout(function() { if (!modal.classList.contains('active')) modal.style.display = 'none'; }, 250);
      }
      document.body.style.overflow = '';
    }

    function showEventsInline(dateStr, events) {
      var parts = dateStr.split('-');
      var m = parseInt(parts[1]) - 1; var d = parseInt(parts[2]); var y = parseInt(parts[0]);

      var titleEl = document.getElementById('calEventsTitle');
      if (titleEl) titleEl.textContent = 'Kegiatan \u2014 ' + d + ' ' + MONTHS_ID[m] + ' ' + y;

      var list = document.getElementById('calEventsList');
      if (list) {
        if (events && events.length > 0) {
          list.innerHTML = events.map(function(ev) {
            return '<div class="cal-event-card"><span class="cal-event-card__badge">' + ev.kategori + '</span><h4>' + ev.judul + '</h4><p>' + ev.desc + '</p></div>';
          }).join('');
        } else {
          list.innerHTML = '<p style="color:var(--text-muted);font-size:0.9rem;">Tidak ada kegiatan pada tanggal ini.</p>';
        }
      }
      var calEvents = document.getElementById('calEvents');
      if (calEvents) calEvents.classList.add('active');

      // Highlight selected cell
      var all = document.querySelectorAll('.cal-cell--selected');
      for (var i = 0; i < all.length; i++) all[i].classList.remove('cal-cell--selected');
      var cells = document.querySelectorAll('.cal-cell');
      for (var j = 0; j < cells.length; j++) {
        if (cells[j].getAttribute('data-date') === dateStr) cells[j].classList.add('cal-cell--selected');
      }
    }

    // Expose globally
    window.openCalendarModal = openCalendarModal;
    window.openCalendarModalDirect = openCalendarModalDirect;
    window.closeCalModal = closeCalModal;

    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCalModal(); });

    // Initialize — wait for full page load to avoid conflicts with deferred scripts
    window.addEventListener('load', initInteractiveCalendar);
  </script>
</body>
</html>
