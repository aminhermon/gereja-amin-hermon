                  📅 Kolom 1 (Ibadah 1)
                </h4>
                <div class="form-group" style="margin-bottom:.8rem;">
                  <label style="font-weight:600;">Tanggal Ibadah 1</label>
                  <input type="text" name="ibadah1_nama" value="<%= db.pelayanan.jadwalPelayan.ibadah1.nama %>" placeholder="Contoh: Minggu, 6 September 2026" required>
                </div>
