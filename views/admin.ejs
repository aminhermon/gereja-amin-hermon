          <% if(db.pelayanan.warta) { db.pelayanan.warta.forEach(function(w) { %>
          <div class="warta-row">
            <span><strong><%= w.judul %></strong> — <%= w.tanggal %> <% if (w.file) { %><a href="/<%= w.file %>" target="_blank" style="color:var(--gold); font-size:0.75rem; margin-left:8px;">[Lihat PDF]</a><% } %></span>
            <form action="/admin/media/warta/delete/<%= w.id %>" method="POST" onsubmit="return confirm('Hapus warta ini beserta file PDF fisiknya?')">
              <button type="submit" class="btn btn--danger btn--sm" title="Hapus Warta & File">🗑 Hapus</button>
            </form>
          </div>
          <% }); } %>
        </div>

        <!-- Renungan Harian -->
        <div class="card">
          <h2 class="card-title">📖 Renungan Harian</h2>
          <form action="/admin/media/renungan" method="POST" style="margin-bottom:1rem;">
            <div class="grid-3">
              <div class="form-group"><label>Judul *</label><input type="text" name="judul" placeholder="Judul Renungan" required></div>
              <div class="form-group"><label>Tanggal *</label><input type="date" name="tanggal" required></div>
              <div class="form-group"><label>Ayat Alkitab *</label><input type="text" name="ayat" placeholder="Mazmur 119:105" required></div>
            </div>
            <div class="form-group"><label>Ayat Lengkap (opsional)</label><textarea name="ayatLengkap" rows="2" placeholder="Firman-Mu itu pelita bagi kakiku..."></textarea></div>
            <div class="form-group"><label>Kutipan Singkat (opsional)</label><textarea name="kutipan" rows="2" placeholder="Ringkasan satu kalimat..."></textarea></div>
            <div class="form-group"><label>Isi Renungan *</label><textarea name="isi" rows="4" required placeholder="Tuliskan isi renungan lengkap..."></textarea></div>
            <div class="form-group"><label>💭 Refleksi (opsional)</label><textarea name="refleksi" rows="2" placeholder="Pertanyaan refleksi untuk direnungkan..."></textarea></div>
            <div class="form-group"><label>📋 Aplikasi (opsional)</label><textarea name="aplikasi" rows="2" placeholder="Cara menerapkan dalam kehidupan sehari-hari..."></textarea></div>
            <div class="form-group"><label>🙏 Doa Penutup (opsional)</label><textarea name="doa" rows="2" placeholder="Tuhan Yesus, terima kasih..."></textarea></div>
            <div class="grid-3">
              <div class="form-group"><label>✍️ Penulis</label><input type="text" name="penulis" placeholder="Tim Renungan AMIN Hermon"></div>
              <div class="form-group"><label>🏷️ Kategori</label>
                <select name="kategori">
                  <option value="">Pilih Kategori</option>
                  <option value="Iman">Iman</option>
                  <option value="Kasih">Kasih</option>
                  <option value="Pengharapan">Pengharapan</option>
                  <option value="Doa">Doa</option>
                  <option value="Pelayanan">Pelayanan</option>
                  <option value="Keluarga">Keluarga</option>
                  <option value="Kesabaran">Kesabaran</option>
                  <option value="Ucapan Syukur">Ucapan Syukur</option>
                </select>
              </div>
              <div class="form-group"><label>🎧 URL Audio</label><input type="url" name="audioUrl" placeholder="https://... atau link MP3"></div>
            </div>
            <button type="submit" class="btn btn--gold">➕ Tambah Renungan</button>
          </form>
          <hr class="divider">
          <h4 style="color:var(--navy); margin-bottom:.5rem;">Daftar Renungan (<%= db.mediaGaleri.renungan ? db.mediaGaleri.renungan.length : 0 %>)</h4>
          <% if(db.mediaGaleri.renungan) { db.mediaGaleri.renungan.sort((a,b)=>new Date(b.tanggal)-new Date(a.tanggal)).forEach(function(r) { %>
          <div class="warta-row">
            <span><strong><%= r.judul %></strong> (<%= r.tanggal %>) — <%= r.ayat %><% if(r.kategori) { %> · <span style="color:var(--gold);"><%= r.kategori %></span><% } %><% if(r.audioUrl) { %> 🎧<% } %></span>
            <form action="/admin/media/renungan/delete/<%= r.id %>" method="POST" onsubmit="return confirm('Hapus renungan ini?')"><button type="submit" class="btn btn--danger btn--sm">🗑</button></form>
          </div>
          <% }); } %>
        </div>

        <!-- Video Khotbah -->
        <div class="card">
          <h2 class="card-title">🎥 Video Khotbah</h2>
          <form action="/admin/media/video" method="POST" style="margin-bottom:1rem;">
            <div class="grid-2">
              <div class="form-group"><label>Judul Khotbah</label><input type="text" name="judul" placeholder="Kasih yang Mengubahkan" required></div>
              <div class="form-group"><label>Pembicara</label><input type="text" name="pembicara" placeholder="Pdt. Samuel Harapan" required></div>
            </div>
            <div class="grid-2">
              <div class="form-group"><label>Tanggal (YYYY-MM-DD)</label><input type="date" name="tanggal" required></div>
              <div class="form-group"><label>Embed URL (YouTube)</label><input type="text" name="embedUrl" placeholder="https://www.youtube.com/embed/..." required></div>
            </div>
            <button type="submit" class="btn btn--gold">➕ Tambah Video</button>
          </form>
          <hr class="divider">
          <h4 style="color:var(--navy); margin-bottom:.5rem;">Daftar Video (<%= db.mediaGaleri.videos ? db.mediaGaleri.videos.length : 0 %>)</h4>
          <% if(db.mediaGaleri.videos) { db.mediaGaleri.videos.sort((a,b)=>new Date(b.tanggal)-new Date(a.tanggal)).forEach(function(v) { %>
          <div class="warta-row">
            <span><strong><%= v.judul %></strong> oleh <%= v.pembicara %> (<%= v.tanggal %>)</span>
            <form action="/admin/media/video/delete/<%= v.id %>" method="POST" onsubmit="return confirm('Hapus video ini?')"><button type="submit" class="btn btn--danger btn--sm">🗑</button></form>
          </div>
          <% }); } %>
        </div>

        <!-- Upload Foto -->
        <div class="card">
          <h2 class="card-title">📸 Upload Foto Galeri</h2>
          <form action="/admin/media/photo" method="POST" enctype="multipart/form-data">
            <div class="grid-2">
              <div class="form-group"><label>Caption / Keterangan</label><input type="text" name="caption" placeholder="Ibadah Minggu Pagi" required></div>
              <div class="form-group"><label>File Foto</label><input type="file" name="photo" accept="image/*" required></div>
            </div>
            <button type="submit" class="btn btn--gold">➕ Upload Foto</button>
          </form>
        </div>

        <!-- Galeri Saat Ini -->
        <div class="card">
          <h2 class="card-title">🖼️ Galeri Saat Ini (<%= db.mediaGaleri.photos.length %> foto)</h2>
          <div class="photo-grid">
            <% db.mediaGaleri.photos.forEach(function(p) { %>
            <div class="photo-item">
              <img src="/<%= p.src %>" alt="<%= p.caption %>" title="<%= p.caption %>">
              <div class="photo-cap"><%= p.caption || 'Foto Galeri' %></div>
              <form action="/admin/media/photo/delete/<%= p.id %>" method="POST" class="del" onsubmit="return confirm('Hapus foto ini beserta file fisiknya?')">
                <button type="submit" class="btn btn--danger btn--xs" title="Hapus foto dan file">✕</button>
              </form>
            </div>
            <% }); %>
          </div>
          <% if (db.mediaGaleri.photos.length === 0) { %>
          <p style="color:var(--text-muted); font-style:italic;">Belum ada foto yang diunggah.</p>
          <% } %>
        </div>

        <!-- Hero Media -->
        <div class="card">
          <h2 class="card-title">🖼️ Hero Banner Halaman</h2>
          <form action="/admin/media/hero" method="POST" enctype="multipart/form-data">
            <div class="grid-2">
              <div class="form-group"><label>Judul (HTML)</label><textarea name="titleHTML" rows="2"><%= db.mediaGaleri.hero.titleHTML %></textarea></div>
              <div class="form-group"><label>Sub-judul</label><textarea name="subtitle" rows="2"><%= db.mediaGaleri.hero.subtitle %></textarea></div>
            </div>
            <div class="form-group">
              <label>Gambar Latar Hero</label>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px;">
                <div class="img-preview-box">
                  <img src="/<%= db.mediaGaleri.hero.bgImage %>" alt="Hero BG">
                  <span class="file-info"><%= db.mediaGaleri.hero.bgImage %></span>
                </div>
                <% if (db.mediaGaleri.hero.bgImage && db.mediaGaleri.hero.bgImage.startsWith('uploads/')) { %>
                <button type="button" class="btn btn--outline-danger btn--xs" onclick="if(confirm('Hapus file background hero dan reset ke default?')) document.getElementById('formResetHeroMedia').submit();">🗑️ Hapus & Reset</button>
                <% } %>
              </div>
              <input type="file" name="bgImage" accept="image/*">
            </div>
            <button type="submit" class="btn btn--gold">💾 Simpan</button>
          </form>
          <form id="formResetHeroMedia" action="/admin/delete-file/hero/media" method="POST" style="display:none;"></form>
        </div>
      </div>

      <!-- ============================== TAB: HUBUNGI KAMI & FAQ ============================== -->
      <div class="tab-content <%= tab === 'contact' ? 'active' : '' %>">

        <!-- Hero -->
        <div class="card">
          <h2 class="card-title">🖼️ Hero Banner</h2>
          <form action="/admin/contact/hero" method="POST" enctype="multipart/form-data">
            <div class="grid-2">
              <div class="form-group"><label>Judul (HTML)</label><textarea name="titleHTML" rows="2"><%= db.contactFaq.hero.titleHTML %></textarea></div>
              <div class="form-group"><label>Sub-judul</label><textarea name="subtitle" rows="2"><%= db.contactFaq.hero.subtitle %></textarea></div>
            </div>
            <div class="form-group">
              <label>Gambar Latar Hero</label>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:6px;">
                <div class="img-preview-box">
                  <img src="/<%= db.contactFaq.hero.bgImage %>" alt="Hero BG">
                  <span class="file-info"><%= db.contactFaq.hero.bgImage %></span>
                </div>
                <% if (db.contactFaq.hero.bgImage && db.contactFaq.hero.bgImage.startsWith('uploads/')) { %>
                <button type="button" class="btn btn--outline-danger btn--xs" onclick="if(confirm('Hapus file background hero dan reset ke default?')) document.getElementById('formResetHeroContact').submit();">🗑️ Hapus & Reset</button>
                <% } %>
              </div>
              <input type="file" name="bgImage" accept="image/*">
            </div>
            <button type="submit" class="btn btn--gold">💾 Simpan</button>
          </form>
          <form id="formResetHeroContact" action="/admin/delete-file/hero/contact" method="POST" style="display:none;"></form>
        </div>

        <!-- WhatsApp -->
        <div class="card">
          <h2 class="card-title">💬 WhatsApp</h2>
          <form action="/admin/contact/whatsapp" method="POST">
            <div class="grid-3">
              <div class="form-group"><label>Nomor WhatsApp</label><input type="text" name="number" value="<%= db.contactFaq.whatsapp.number %>"><span class="help-text">Format: 6281234567890</span></div>
              <div class="form-group"><label>Label Tombol</label><input type="text" name="label" value="<%= db.contactFaq.whatsapp.label %>"></div>
              <div class="form-group"><label>Pesan Default</label><input type="text" name="message" value="<%= db.contactFaq.whatsapp.message %>"></div>
            </div>
            <button type="submit" class="btn btn--gold">💾 Simpan</button>
          </form>
        </div>

      </div>

      <!-- ============================== TAB: KALENDER (INTEGRASI KOMSEK & BERANDA) ============================== -->
      <div class="tab-content <%= tab === 'kalender' ? 'active' : '' %>">
        <div class="card">
          <h2 class="card-title">📅 Tambah Agenda / Kegiatan Baru</h2>
          <p class="card-subtitle">Kegiatan yang ditambahkan akan muncul secara interaktif di Kalender Beranda serta halaman detail Komisi / Sektor terkait.</p>
          <form action="/admin/kalender/add" method="POST" style="margin-bottom:1.5rem;">
            <div class="grid-3">
              <div class="form-group">
                <label>Judul Agenda / Kegiatan</label>
                <input type="text" name="judul" placeholder="Contoh: Ibadah Padang Pemuda" required>
              </div>
              <div class="form-group">
                <label>Tanggal Pelaksanaan</label>
                <input type="date" name="tanggal" required>
              </div>
              <div class="form-group">
                <label>Waktu / Jam (Opsional)</label>
                <input type="text" name="waktu" placeholder="Contoh: 09:00 WIB atau 17:00 - 19:00 WIB">
              </div>
            </div>

            <div class="grid-2">
              <div class="form-group">
                <label>Kategori & Terhubung ke KomSek</label>
                <select name="kategori" required>
                  <optgroup label="Ibadah & Kegiatan Umum Gereja">
                    <option value="Ibadah Umum:">⛪ Ibadah Umum / Raya</option>
                    <option value="Kegiatan Umum:">🌟 Kegiatan Umum Gereja</option>
                    <option value="Ibadah Doa:">🙏 Ibadah Doa & Puasa</option>
                  </optgroup>
                  <% if (db.komsek && db.komsek.komisi && db.komsek.komisi.length) { %>
                  <optgroup label="Komisi Kategorial">
                    <% db.komsek.komisi.forEach(function(k) { %>
                    <option value="<%= k.nama %>:<%= k.slug %>">👥 <%= k.nama %></option>
                    <% }); %>
                  </optgroup>
                  <% } %>
                  <% if (db.komsek && db.komsek.sektor && db.komsek.sektor.length) { %>
                  <optgroup label="Sektor Pelayanan">
                    <% db.komsek.sektor.forEach(function(s) { %>
                    <option value="<%= s.nama %>:<%= s.slug %>">🏡 <%= s.nama %></option>
                    <% }); %>
                  </optgroup>
                  <% } %>
                </select>
                <span class="help-text">Memilih Komisi/Sektor akan menghubungkan agenda ini langsung ke halaman KomSek yang bersangkutan.</span>
              </div>
              <div class="form-group">
                <label>Deskripsi & Lokasi</label>
                <input type="text" name="desc" placeholder="Contoh: Gedung Gereja AMIN Hermon Lt. 2 / Rumah Kel. Bpk. Gea" required>
              </div>
            </div>

            <button type="submit" class="btn btn--gold">➕ Simpan Agenda Kalender</button>
          </form>

          <hr class="divider">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
            <h4 style="color:var(--navy); margin:0;">📋 Daftar Agenda Kalender Terdaftar (<%= db.kalender ? db.kalender.length : 0 %>)</h4>
            <span style="font-size:0.8rem; color:var(--text-muted);">Diurutkan berdasarkan tanggal pelaksanaan</span>
          </div>

          <% if(db.kalender && db.kalender.length > 0) { %>
            <div style="display:flex; flex-direction:column; gap:0.6rem;">
              <% db.kalender.sort(function(a,b){ return new Date(a.tanggal) - new Date(b.tanggal); }).forEach(function(k) { %>
              <div class="warta-row" style="padding: 0.85rem 1rem;">
                <div style="display:flex; flex-direction:column; gap:4px;">
                  <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                    <strong style="color:var(--navy); font-size:0.95rem;"><%= k.judul %></strong>
                    <span style="background:rgba(200,169,81,0.18); color:var(--navy); border:1px solid rgba(200,169,81,0.4); padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight:600;">
                      <%= k.kategori %>
                    </span>
                    <% if (k.waktu) { %>
                    <span style="font-size:0.75rem; color:var(--text-muted); font-weight:500;">⏰ <%= k.waktu %></span>
                    <% } %>
                  </div>
                  <div style="font-size:0.82rem; color:var(--text-muted);">
                    📅 <strong><%= k.tanggal %></strong> &bull; 📍 <%= k.desc %>
                  </div>
                </div>
                <form action="/admin/kalender/delete/<%= k.id %>" method="POST" onsubmit="return confirm('Hapus agenda \'<%= k.judul %>\' dari kalender?')">
                  <button type="submit" class="btn btn--danger btn--xs" style="padding:5px 10px;" title="Hapus Agenda">🗑️ Hapus</button>
                </form>
              </div>
              <% }); %>
            </div>
          <% } else { %>
            <div style="text-align:center; padding:2.5rem; color:var(--text-muted); background:var(--bg); border-radius:var(--radius); border:1px solid var(--border);">
              <div style="font-size:2rem; margin-bottom:6px;">📅</div>
              <p style="margin:0; font-weight:600;">Belum ada agenda di kalender kegiatan.</p>
              <p style="font-size:0.8rem; margin-top:4px;">Gunakan formulir di atas untuk menambahkan kegiatan pertama.</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- ============================== TAB: FILE MANAGER ============================== -->
      <div class="tab-content <%= tab === 'files' ? 'active' : '' %>">
        <div class="card">
          <h2 class="card-title">📁 Manajemen File & Media (Uploads)</h2>
          <p class="card-subtitle">Kelola dan hapus semua file yang diunggah ke server (gambar, foto galeri, logo, background hero, video hero, warta PDF).</p>

          <% 
            let totalFiles = (typeof files !== 'undefined') ? files.length : 0;
            let totalBytes = (typeof files !== 'undefined') ? files.reduce((acc, f) => acc + (f.size || 0), 0) : 0;
            let totalFormatted = totalBytes >= 1024 * 1024 
              ? (totalBytes / (1024 * 1024)).toFixed(2) + ' MB' 
              : (totalBytes / 1024).toFixed(1) + ' KB';
            let imgCount = (typeof files !== 'undefined') ? files.filter(f => f.isImage).length : 0;
            let videoCount = (typeof files !== 'undefined') ? files.filter(f => f.isVideo).length : 0;
            let pdfCount = (typeof files !== 'undefined') ? files.filter(f => f.isPdf).length : 0;
          %>

          <!-- Stats Bar -->
          <div class="fm-stats-bar" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
            <div class="fm-stat-box">
              <h3><%= totalFiles %></h3>
              <span>Total File</span>
            </div>
            <div class="fm-stat-box">
              <h3><%= totalFormatted %></h3>
              <span>Total Ukuran</span>
            </div>
            <div class="fm-stat-box">
              <h3><%= imgCount %></h3>
              <span>Gambar / Foto</span>
            </div>
            <div class="fm-stat-box">
              <h3><%= videoCount %></h3>
              <span>Video</span>
            </div>
            <div class="fm-stat-box">
              <h3><%= pdfCount %></h3>
              <span>Dokumen PDF</span>
            </div>
          </div>

          <!-- Upload Form -->
          <div class="fm-upload-zone">
            <form action="/admin/files/upload" method="POST" enctype="multipart/form-data">
              <h4 style="color:var(--navy); margin-bottom:.5rem;">📤 Unggah File Baru ke Server</h4>
              <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1rem;">Pilih satu atau beberapa file sekaligus (JPG, PNG, WebP, GIF, PDF, MP4, WebM, MOV max 100MB per file).</p>
              <div style="display:inline-flex; align-items:center; gap:10px; flex-wrap:wrap; justify-content:center;">
                <input type="file" name="files" multiple required accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.mp4,.webm,.mov" style="font-size:0.85rem;">
                <button type="submit" class="btn btn--gold">⬆️ Mulai Upload</button>
              </div>
            </form>
          </div>

          <!-- Toolbar: Search & Bulk Action -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; gap:1rem; flex-wrap:wrap;">
            <div style="flex:1; min-width:200px;">
              <input type="text" id="fmSearchInput" placeholder="🔍 Cari nama file..." onkeyup="filterFiles()" style="width:100%; padding:0.55rem 0.85rem; border:1px solid var(--border); border-radius:var(--radius); font-size:0.85rem;">
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
              <button type="button" id="btnBulkDelete" class="btn btn--danger btn--sm" style="display:none;" onclick="submitBulkDelete()">🗑️ Hapus yang Dipilih (<span id="selectedCount">0</span>)</button>
              <button type="button" class="btn btn--outline btn--sm" onclick="toggleSelectAll()">☑️ Pilih Semua</button>
            </div>
          </div>

          <!-- Hidden Bulk Delete Form -->
          <form id="formBulkDelete" action="/admin/files/delete" method="POST" style="display:none;">
            <div id="bulkDeleteInputs"></div>
          </form>

          <!-- Files Grid -->
          <% if (typeof files !== 'undefined' && files.length > 0) { %>
          <div class="fm-grid" id="fmFileGrid">
            <% files.forEach(function(f) { %>
            <div class="fm-card" data-filename="<%= f.name.toLowerCase() %>">
              <div class="fm-card__preview">
                <input type="checkbox" class="fm-checkbox" value="<%= f.name %>" onchange="updateSelectedCount()" style="position:absolute; top:8px; left:8px; z-index:10; width:18px; height:18px; cursor:pointer;">
                <% if (f.isImage) { %>
                  <img src="/<%= f.path %>" alt="<%= f.name %>" loading="lazy">
                <% } else if (f.isVideo) { %>
                  <video src="/<%= f.path %>" style="width:100%; height:100%; object-fit:cover;" muted></video>
                  <span style="position:absolute; bottom:6px; right:6px; background:rgba(0,0,0,0.75); color:#fff; font-size:0.65rem; padding:2px 6px; border-radius:4px; font-weight:600;">🎬 Video</span>
                <% } else if (f.isPdf) { %>
                  <div class="file-icon">📄</div>
                <% } else { %>
                  <div class="file-icon">📁</div>
                <% } %>
              </div>
              <div class="fm-card__body">
                <div class="fm-card__name" title="<%= f.name %>"><%= f.name %></div>
                <div class="fm-card__meta">
                  <span><%= f.sizeFormatted %></span>
                  <span><%= new Date(f.createdAt).toLocaleDateString('id-ID') %></span>
                </div>
                <div class="fm-card__actions">
                  <a href="/<%= f.path %>" target="_blank" class="btn btn--outline btn--xs" title="Buka / Download file">👁️ Buka</a>
                  <form action="/admin/files/delete" method="POST" style="margin:0; flex:1;" onsubmit="return confirm('Hapus permanen file \'<%= f.name %>\' dari server? Tindakan ini tidak dapat dibatalkan.')">
                    <input type="hidden" name="filename" value="<%= f.name %>">
                    <button type="submit" class="btn btn--danger btn--xs" style="width:100%;" title="Hapus file ini permanen">🗑️ Hapus</button>
                  </form>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div style="text-align:center; padding:3rem; color:var(--text-muted); background:var(--bg); border-radius:var(--radius); border:1px solid var(--border);">
            <div style="font-size:2.5rem; margin-bottom:8px;">📁</div>
            <p style="font-weight:600; color:var(--navy); margin-bottom:4px;">Folder Upload Kosong</p>
            <p style="font-size:0.85rem;">Belum ada file yang diunggah ke folder uploads/.</p>
          </div>
          <% } %>

        </div>
      </div>

    </div>
  </main>

  <script>
    // === ROCK-SOLID SCROLL & POSITION PRESERVATION ===
    // Continuously tracks scroll on window, document, and .content container
    function recordAdminScroll(elem) {
      try {
        const contentEl = document.querySelector('.content');
        const cScroll = contentEl ? contentEl.scrollTop : 0;
        const wScroll = window.scrollY || (document.documentElement ? document.documentElement.scrollTop : 0) || (document.body ? document.body.scrollTop : 0);
        
        sessionStorage.setItem('adminContentScrollTop', cScroll.toString());
        sessionStorage.setItem('adminWindowScrollY', wScroll.toString());

        if (elem && elem.id) {
          sessionStorage.setItem('adminAnchorId', elem.id);
        } else if (elem) {
          const card = elem.closest('.card, .item-card, .fm-card, form');
          if (card && card.id) {
            sessionStorage.setItem('adminAnchorId', card.id);
          }
        }
      } catch (e) {}
    }

    // Auto-record on any scroll event (passive)
    window.addEventListener('scroll', function() { recordAdminScroll(); }, { passive: true });
    const cEl = document.querySelector('.content');
    if (cEl) {
      cEl.addEventListener('scroll', function() { recordAdminScroll(); }, { passive: true });
    }

    // Record on any form submit or button click
    document.addEventListener('submit', function(e) {
      recordAdminScroll(e.target);
    }, true);

    document.addEventListener('click', function(e) {
      const btn = e.target.closest('button[type="submit"], input[type="submit"], a.btn, .btn');
      if (btn) {
        recordAdminScroll(btn);
      }
    }, true);

    window.addEventListener('beforeunload', function() {
      recordAdminScroll();
    });

    // Multi-pass restoration across all layout lifecycle stages
    function applyAdminScrollRestoration() {
      try {
        const cScroll = sessionStorage.getItem('adminContentScrollTop');
        const wScroll = sessionStorage.getItem('adminWindowScrollY');

        const contentEl = document.querySelector('.content');
        if (cScroll && contentEl && parseInt(cScroll, 10) > 0) {
          contentEl.scrollTop = parseInt(cScroll, 10);
        }
        if (wScroll && parseInt(wScroll, 10) > 0) {
          const s = parseInt(wScroll, 10);
          window.scrollTo(0, s);
          if (document.documentElement) document.documentElement.scrollTop = s;
          if (document.body) document.body.scrollTop = s;
        }
      } catch (e) {}
    }

    // Run multi-pass restoration
    applyAdminScrollRestoration();
    document.addEventListener('DOMContentLoaded', applyAdminScrollRestoration);
    window.addEventListener('load', function() {
      applyAdminScrollRestoration();
      setTimeout(applyAdminScrollRestoration, 50);
      setTimeout(applyAdminScrollRestoration, 150);
      setTimeout(applyAdminScrollRestoration, 350);
    });

    // === Safe Confirm & Delete ===
    function confirmAndDelete(btn) {
      var name = btn.getAttribute('data-del-name') || '';
      var formId = btn.getAttribute('data-del-form');
      if (confirm('Hapus foto ' + name + '?')) {
        recordAdminScroll(btn);
        document.getElementById(formId).submit();
      }
    }

    function filterFiles() {
      const input = document.getElementById('fmSearchInput');
      const filter = input ? input.value.toLowerCase() : '';
      const cards = document.querySelectorAll('#fmFileGrid .fm-card');
      let visible = 0;
      cards.forEach(card => {
        const name = card.getAttribute('data-filename') || '';
        if (name.includes(filter)) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });
      const countEl = document.getElementById('fmVisibleCount');
      if (countEl) countEl.textContent = visible;
    }

    let allSelected = false;
    function toggleSelectAll() {
      const checkboxes = document.querySelectorAll('.fm-checkbox');
      allSelected = !allSelected;
      checkboxes.forEach(cb => {
        if (cb.closest('.fm-card').style.display !== 'none') {
          cb.checked = allSelected;
        }
      });
      updateSelectedCount();
    }

    function updateSelectedCount() {
      const checked = document.querySelectorAll('.fm-checkbox:checked');
      const count = checked.length;
      const countEl = document.getElementById('selectedCount');
      const btn = document.getElementById('btnBulkDelete');
      if (countEl) countEl.textContent = count;
      if (btn) {
        btn.style.display = count > 0 ? 'inline-flex' : 'none';
      }
    }

    function submitBulkDelete() {
      const checked = document.querySelectorAll('.fm-checkbox:checked');
      if (checked.length === 0) return;
      if (!confirm('Hapus permanen ' + checked.length + ' file yang dipilih dari server?')) return;

      recordAdminScroll(document.getElementById('btnBulkDelete'));
      const container = document.getElementById('bulkDeleteInputs');
      container.innerHTML = '';
      checked.forEach(cb => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'filenames';
        input.value = cb.value;
        container.appendChild(input);
      });
      document.getElementById('formBulkDelete').submit();
    }
  </script>

</body>
</html>
