<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= general.churchName %> — Komunitas yang bertumbuh dalam iman, kasih, dan pengharapan.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= general.siteUrl || 'https://aminhermon.org' %>/">
  <title><%= general.churchName %> — Rumah Kasih, Rumah Bagi Semua</title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= general.churchName %> — Rumah Kasih, Rumah Bagi Semua">
  <meta property="og:description" content="Komunitas yang bertumbuh dalam iman, kasih, dan pengharapan. Kami menanti kehadiran Anda setiap hari Minggu.">
  <meta property="og:url" content="<%= general.siteUrl || 'https://aminhermon.org' %>/">
  <meta property="og:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= home.hero.bgImage %>">
  <meta property="og:site_name" content="<%= general.churchName %>">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= general.churchName %> — Rumah Kasih, Rumah Bagi Semua">
  <meta name="twitter:description" content="Komunitas yang bertumbuh dalam iman, kasih, dan pengharapan.">
  <meta name="twitter:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= home.hero.bgImage %>">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Church",
    "name": "<%= general.churchName %>",
    "description": "Komunitas yang bertumbuh dalam iman, kasih, dan pengharapan. Kami menanti kehadiran Anda setiap hari Minggu.",
    "url": "<%= general.siteUrl || 'https://aminhermon.org' %>",
    "logo": "<%= general.siteUrl || 'https://aminhermon.org' %>/<%= general.logoPath %>",
    "image": "<%= general.siteUrl || 'https://aminhermon.org' %>/<%= home.hero.bgImage %>",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Bekasi",
      "addressRegion": "Jawa Barat",
      "addressCountry": "ID"
    },
    "sameAs": []
  }
  </script>

  <!-- Preload: Hero Image -->
  <link rel="preload" as="image" href="<%= home.hero.bgImage %>" fetchpriority="high">

  <!-- Preload: Fonts (Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
  <link rel="stylesheet" href="css/style.min.css?v=14">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body>
  <%- include('partials/skeleton') %>

  <!-- ========== NAVIGATION ========== -->
  <nav class="navbar" id="navbar" aria-label="Main navigation">
    <div class="navbar__inner">
      <a href="/" class="navbar__logo" aria-label="<%= general.churchName %> - Home">
      </a>
      <div class="navbar__menu" id="nav-menu">
        <a href="/" class="navbar__link active">Beranda</a>
        <a href="/visit.html" class="navbar__link">Baru di Sini?</a>
        <a href="/about.html" class="navbar__link">Tentang Gereja</a>
        <a href="/pelayanan.html" class="navbar__link">Pelayanan</a>

        <!-- KomSek Dropdown -->
        <div class="navbar__dropdown" id="komsek-dropdown">
          <button class="navbar__dropdown-toggle" type="button" aria-expanded="false" aria-haspopup="true">
            <span>KomSek</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="navbar__dropdown-menu navbar__dropdown-menu--mega">
            <div class="navbar__mega-col">
              <span class="navbar__mega-heading">Komisi</span>
              <% komsek.komisi.forEach(function(k) { %>
              <a href="/komsek/<%= k.slug %>" class="navbar__dropdown-item"><%= k.nama %></a>
              <% }); %>
            </div>
            <div class="navbar__mega-col">
              <span class="navbar__mega-heading">Sektor</span>
              <% komsek.sektor.forEach(function(s) { %>
              <a href="/komsek/<%= s.slug %>" class="navbar__dropdown-item"><%= s.nama %></a>
              <% }); %>
            </div>
          </div>
        </div>

        <a href="/media.html" class="navbar__link">Media</a>
        <a href="/contact.html" class="navbar__link">Hubungi Kami</a>
        <form action="/search" method="GET" class="navbar__search">
          <input type="text" name="q" placeholder="Cari..." aria-label="Search" required>
          <button type="submit" aria-label="Submit Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </button>
        </form>
      </div>
      <button class="navbar__hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>

  <!-- ========== HERO SECTION (Full Screen) ========== -->
  <section class="hero hero--full" id="hero">
    <div class="hero__bg">
      <% if (home.hero.bgVideo) { %>
        <video autoplay muted loop playsinline poster="/<%= home.hero.bgImage %>" id="hero-video">
          <source src="/<%= home.hero.bgVideo %>" type="<%= home.hero.bgVideo.endsWith('.webm') ? 'video/webm' : 'video/mp4' %>">
          <img src="/<%= home.hero.bgImage %>" alt="<%= general.churchName %>" loading="eager">
        </video>
      <% } else { %>
        <img src="/<%= home.hero.bgImage %>" alt="<%= general.churchName %>" loading="eager">
      <% } %>
    </div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__logo-wrap">
        <img src="/assets/images/logo-gereja-amin-3d.png?v=10" alt="Logo Gereja AMIN" class="hero__logo">
      </div>
      <h1><%- home.hero.titleHTML %></h1>
      <p class="hero__subtitle"><%= home.hero.subtitle %></p>
      <div class="hero__actions">
        <a href="<%= home.hero.ctaLink %>" class="btn btn--gold btn--lg" id="cta-visit">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <%= home.hero.ctaText %>
        </a>
      </div>
    </div>
    <div class="hero__scroll-indicator">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
  </section>

  <!-- ========== RENUNGAN HARIAN (YouVersion Style) ========== -->
  <section class="section section--off-white" id="renungan-otomatis" style="padding: 4rem 0;">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Renungan <span class="text-gold">Harian</span></h2>
        <span class="gold-line"></span>
        <p>Santapan rohani untuk menumbuhkan iman Anda setiap hari</p>
      </div>

      <div class="devotional-card" data-aos="fade-up" data-aos-delay="100">
        <!-- Header -->
        <div class="devotional-header">
          <div class="devotional-badge">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span id="devDayNum">Hari ke-1 dari 31</span>
          </div>
          <div class="devotional-date">
            <script>document.write(new Date().toLocaleDateString('id-ID',{weekday:'long',year:'numeric',month:'long',day:'numeric'}))</script>
          </div>
        </div>

        <!-- Progress -->
        <div class="devotional-progress">
          <div class="devotional-progress__fill" id="devProgressFill" style="width: 3%"></div>
        </div>

        <!-- Ayat Utama -->
        <div class="devotional-verse">
          <svg class="devotional-quote-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" opacity="0.15"><path d="M14.017 21v-7.391c0-5.714 4.82-8.609 8.354-9.609l.942 2.604c-3.136 1.054-6.386 3.636-6.386 7.429h5.688V21h-8.598zm-11.419 0v-7.391c0-5.714 4.82-8.609 8.354-9.609l.942 2.604c-3.136 1.054-6.386 3.636-6.386 7.429h5.688V21H2.598z"/></svg>
          <p class="devotional-verse__text" id="devVerseText">Memuat firman Tuhan...</p>
          <span class="devotional-verse__ref" id="devVerseRef">-</span>
        </div>

        <!-- Renungan -->
        <div class="devotional-section">
          <div class="devotional-section__label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Renungan
          </div>
          <p class="devotional-section__body" id="devReflection">Memuat renungan...</p>
        </div>

        <!-- Doa Penutup -->
        <div class="devotional-prayer-box">
          <div class="devotional-section__label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            Doa Penutup
          </div>
          <p class="devotional-prayer__text" id="devPrayer">Memuat doa...</p>
        </div>

        <!-- Audio Wave Animation -->
        <div class="devotional-audio-wave" id="devAudioWave" style="display: none;">
          <span></span><span></span><span></span><span></span><span></span>
        </div>

        <!-- Action Buttons -->
        <div class="devotional-actions">
          <button class="devotional-btn devotional-btn--audio" id="devAudioBtn" onclick="speakDevotional()" title="Dengarkan Renungan">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
            Dengarkan
          </button>
          <button class="devotional-btn" onclick="shuffleDevotional()" title="Ganti Renungan">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
            Ganti
          </button>
          <button class="devotional-btn" onclick="shareDevotional()" title="Bagikan ke WhatsApp">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Bagikan
          </button>
          <button class="devotional-btn" id="devCopyBtn" onclick="copyDevotional()" title="Salin Teks">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Salin
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== NEWS & EVENTS (Lundev Carousel) ========== -->
  <section class="carousel" id="news">
    <!-- Main slides (fullscreen) -->
    <div class="carousel__list">
      <% home.news.forEach(function(item, idx) { %>
      <div class="carousel__item" data-idx="<%= idx %>">
        <img src="/<%= item.image %>" alt="<%= item.title %>" loading="lazy">
        <div class="carousel__content">
          <span class="carousel__date"><%= item.date %></span>
          <div class="carousel__title"><%= item.title %></div>
          <div class="carousel__desc"><%= item.desc %></div>
          <div class="carousel__actions">
            <button class="btn btn--gold" onclick="openNewsDetail(<%= idx %>)">
              Selengkapnya
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>

    <!-- Thumbnails (bottom) -->
    <div class="carousel__thumbs">
      <% home.news.forEach(function(item) { %>
      <div class="carousel__thumb">
        <img src="/<%= item.image %>" alt="<%= item.title %>" loading="lazy">
        <div class="carousel__thumb-label"><%= item.title %></div>
      </div>
      <% }); %>
    </div>

    <!-- Arrows (left & right) -->
    <div class="carousel__arrows">
      <button class="carousel__arrow carousel__arrow--prev" id="carouselPrev" aria-label="Previous">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="carousel__arrow carousel__arrow--next" id="carouselNext" aria-label="Next">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
    </div>

    <!-- Time progress bar -->
    <div class="carousel__progress"></div>
  </section>

  <!-- ========== DASHBOARD STATISTIK JEMAAT (Premium Design) ========== -->
  <section class="section section--navy section--stats-premium" id="stats">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Data <span class="text-gold">Jemaat</span></h2>
        <span class="gold-line"></span>
        <p>Keluarga besar Gereja AMIN Hermon dalam angka.</p>
      </div>
      <div class="stats-grid-premium" data-aos="fade-up">
        <div class="stat-card-premium">
          <div class="stat-card-premium__glow"></div>
          <div class="stat-card-premium__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="stat-card-premium__number" data-target="<%= home.stats.totalJemaat %>">0</div>
          <div class="stat-card-premium__label">Total Jemaat</div>
          <div class="stat-card-premium__bar"><span style="width: 100%;"></span></div>
        </div>
        <div class="stat-card-premium">
          <div class="stat-card-premium__glow"></div>
          <div class="stat-card-premium__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="stat-card-premium__number" data-target="<%= home.stats.lakiLaki %>">0</div>
          <div class="stat-card-premium__label">Laki-laki</div>
          <div class="stat-card-premium__bar"><span style="width: <%= home.stats.totalJemaat ? Math.round(home.stats.lakiLaki / home.stats.totalJemaat * 100) : 0 %>%;"></span></div>
        </div>
        <div class="stat-card-premium">
          <div class="stat-card-premium__glow"></div>
          <div class="stat-card-premium__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
          <div class="stat-card-premium__number" data-target="<%= home.stats.perempuan %>">0</div>
          <div class="stat-card-premium__label">Perempuan</div>
          <div class="stat-card-premium__bar"><span style="width: <%= home.stats.totalJemaat ? Math.round(home.stats.perempuan / home.stats.totalJemaat * 100) : 0 %>%;"></span></div>
        </div>
        <div class="stat-card-premium">
          <div class="stat-card-premium__glow"></div>
          <div class="stat-card-premium__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </div>
          <div class="stat-card-premium__number" data-target="<%= home.stats.anakAnak %>">0</div>
          <div class="stat-card-premium__label">Anak-anak</div>
          <div class="stat-card-premium__bar"><span style="width: <%= home.stats.totalJemaat ? Math.round(home.stats.anakAnak / home.stats.totalJemaat * 100) : 0 %>%;"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== KALENDER KEGIATAN & AGENDA (INTERAKTIF) ========== -->
  <section class="section section--navy section--calendar" id="kalender-section">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Kalender <span class="text-gold">Kegiatan</span></h2>
        <span class="gold-line"></span>
        <p>Jadwal ibadah, agenda pelayanan, dan kegiatan KomSek (Komisi & Sektor) Gereja AMIN Hermon.</p>
      </div>

      <!-- Category Filter Pills -->
      <div class="cal-filters" data-aos="fade-up">
        <button type="button" class="cal-filter-btn active" data-filter="all" onclick="setCalendarFilter('all', this)">🌟 Semua Agenda</button>
        <button type="button" class="cal-filter-btn" data-filter="ibadah" onclick="setCalendarFilter('ibadah', this)">⛪ Ibadah & Umum</button>
        <button type="button" class="cal-filter-btn" data-filter="komisi" onclick="setCalendarFilter('komisi', this)">👥 Komisi Kategorial</button>
        <button type="button" class="cal-filter-btn" data-filter="sektor" onclick="setCalendarFilter('sektor', this)">🏡 Sektor Pelayanan</button>
      </div>

      <!-- Main Calendar Card with Glassmorphic Luxury Style -->
      <div class="cal-main-wrapper" data-aos="fade-up" data-aos-delay="100">
        <!-- Calendar Navigation Header -->
        <div class="cal-nav">
          <button type="button" class="cal-nav__btn" id="homeCalPrev" aria-label="Bulan sebelumnya">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <div class="cal-nav__title-wrap">
            <h3 class="cal-nav__title" id="homeCalTitle">Agustus 2026</h3>
            <span class="cal-nav__hint">💡 Klik tanggal bertitik emas untuk melihat detail agenda kegiatan</span>
          </div>
          <button type="button" class="cal-nav__btn" id="homeCalNext" aria-label="Bulan berikutnya">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 6 15 12 9 18"/></svg>
          </button>
        </div>

        <!-- Calendar Weekdays Header -->
        <div class="cal-grid__header">
          <span>Min</span><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span>
        </div>

        <!-- Calendar Grid Body -->
        <div class="cal-grid__body" id="homeCalBody">
          <!-- Dynamically generated day cells -->
        </div>
      </div>

      <!-- Upcoming Events Strip -->
      <div class="cal-upcoming-strip" data-aos="fade-up" data-aos-delay="150">
        <div class="cal-upcoming-strip__head">
          <h4>📅 Agenda Terdekat Mendatang</h4>
          <span class="cal-upcoming-strip__sub">Kegiatan sepekan & sebulan ke depan</span>
        </div>
        <div class="cal-upcoming-strip__grid" id="homeUpcomingGrid">
          <!-- Dynamically populated upcoming events -->
        </div>
      </div>
    </div>
  </section>

  <!-- ========== POPUP OVERLAY MODAL AGENDA KALENDER ========== -->
  <div class="cal-modal" id="calModal" role="dialog" aria-modal="true" aria-labelledby="calModalDate">
    <div class="cal-modal__backdrop" onclick="window.closeCalModal()"></div>
    <div class="cal-modal__dialog">
      <button type="button" class="cal-modal__close" onclick="window.closeCalModal()" aria-label="Tutup popup">&times;</button>
      <div class="cal-modal__header">
        <div class="cal-modal__icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <div>
          <span class="cal-modal__subtitle">Agenda Kegiatan Gereja</span>
          <h3 class="cal-modal__title" id="calModalDate">Tanggal</h3>
        </div>
      </div>
      <div class="cal-modal__body" id="calModalBody">
        <!-- Event items injected here -->
      </div>
      <div class="cal-modal__footer">
        <button type="button" class="btn btn--gold btn--sm" onclick="window.closeCalModal()">Tutup</button>
      </div>
    </div>
  </div>

  <!-- ========== NEWS DETAIL MODAL ========== -->
  <div class="news-modal" id="newsModal">
    <div class="news-modal__backdrop" onclick="closeNewsDetail()"></div>
    <div class="news-modal__content">
      <button class="news-modal__close" onclick="closeNewsDetail()">&times;</button>
      <div class="news-modal__img">
        <img id="newsModalImg" src="" alt="">
      </div>
      <div class="news-modal__body">
        <span class="news-modal__date" id="newsModalDate"></span>
        <h2 class="news-modal__title" id="newsModalTitle"></h2>
        <p class="news-modal__desc" id="newsModalDesc"></p>
        <a href="/media.html" class="btn btn--gold" style="margin-top: 1rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          Lihat Galeri Foto
        </a>
      </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
  <script src="js/main.min.js?v=7" defer></script>
  <script>
    // News data for modal
    const newsData = <%- JSON.stringify(home.news || []) %>;

    function openNewsDetail(idx) {
      const item = newsData[idx];
      if (!item) return;
      document.getElementById('newsModalImg').src = '/' + item.image;
      document.getElementById('newsModalDate').textContent = item.date;
      document.getElementById('newsModalTitle').textContent = item.title;
      document.getElementById('newsModalDesc').textContent = item.desc;
      document.getElementById('newsModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeNewsDetail() {
      document.getElementById('newsModal').classList.remove('active');
      document.body.style.overflow = '';
    }

    // =======================================================
    // INTERACTIVE CALENDAR & KOMSEK INTEGRATION
    // =======================================================
    var rawCalendarEvents = <%- JSON.stringify(typeof kalender !== 'undefined' ? kalender : []) %>;
    var komsekData = <%- JSON.stringify(typeof komsek !== 'undefined' ? komsek : { komisi: [], sektor: [] }) %>;

    var MONTHS_ID = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
    var DAYS_ID = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];

    var currentCalYear, currentCalMonth;
    var activeCalFilter = 'all';

    function initHomeCalendar() {
      var now = new Date();
      currentCalYear = now.getFullYear();
      currentCalMonth = now.getMonth();

      renderHomeCalendar();
      renderHomeUpcomingEvents();

      var prevBtn = document.getElementById('homeCalPrev');
      var nextBtn = document.getElementById('homeCalNext');

      if (prevBtn) {
        prevBtn.onclick = function(e) {
          e.preventDefault();
          currentCalMonth--;
          if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
          renderHomeCalendar();
        };
      }
      if (nextBtn) {
        nextBtn.onclick = function(e) {
          e.preventDefault();
          currentCalMonth++;
          if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
          renderHomeCalendar();
        };
      }
    }

    function setCalendarFilter(filter, btn) {
      activeCalFilter = filter;
      var buttons = document.querySelectorAll('.cal-filter-btn');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('active');
      }
      if (btn) btn.classList.add('active');
      renderHomeCalendar();
      renderHomeUpcomingEvents();
    }

    function isEventMatchingFilter(ev, filter) {
      if (!filter || filter === 'all') return true;
      var kat = (ev.kategori || '').toLowerCase();
      var slug = (ev.komsekSlug || '').toLowerCase();
      var judul = (ev.judul || '').toLowerCase();

      if (filter === 'ibadah') {
        return kat.includes('ibadah') || kat.includes('umum') || kat.includes('kegiatan') || judul.includes('ibadah');
      }
      if (filter === 'komisi') {
        return kat.includes('komisi') || slug.startsWith('komisi') || kat.includes('kpa') || kat.includes('pemuda') || kat.includes('perempuan') || kat.includes('bapak');
      }
      if (filter === 'sektor') {
        return kat.includes('sektor') || slug.startsWith('sektor') || kat.includes('maranatha') || kat.includes('berkat') || kat.includes('imanuel') || kat.includes('sion') || kat.includes('yordan');
      }
      return true;
    }

    function findKomsekInfo(ev) {
      var allKomsek = (komsekData.komisi || []).concat(komsekData.sektor || []);
      if (ev.komsekSlug) {
        var found = allKomsek.find(function(k) { return k.slug === ev.komsekSlug; });
        if (found) return found;
      }
      var katLower = (ev.kategori || '').toLowerCase();
      return allKomsek.find(function(k) {
        return katLower.includes(k.nama.toLowerCase().replace('komisi ', '').replace('sektor ', ''));
      });
    }

    function renderHomeCalendar() {
      var titleEl = document.getElementById('homeCalTitle');
      if (titleEl) titleEl.textContent = MONTHS_ID[currentCalMonth] + ' ' + currentCalYear;

      var body = document.getElementById('homeCalBody');
      if (!body) return;
      body.innerHTML = '';

      var firstDay = new Date(currentCalYear, currentCalMonth, 1).getDay();
      var daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      var today = new Date();

      // Empty leading cells
      for (var i = 0; i < firstDay; i++) {
        var empty = document.createElement('div');
        empty.className = 'cal-cell cal-cell--empty';
        body.appendChild(empty);
      }

      // Day cells
      for (var d = 1; d <= daysInMonth; d++) {
        var dateStr = currentCalYear + '-' + String(currentCalMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
        var allEventsOnDate = rawCalendarEvents.filter(function(e) { return e.tanggal === dateStr; });
        var filteredEvents = allEventsOnDate.filter(function(e) { return isEventMatchingFilter(e, activeCalFilter); });
        
        var isToday = (today.getFullYear() === currentCalYear && today.getMonth() === currentCalMonth && today.getDate() === d);

        var cell = document.createElement('div');
        cell.className = 'cal-cell' + (isToday ? ' cal-cell--today' : '') + (filteredEvents.length ? ' cal-cell--has-event' : '');
        cell.setAttribute('data-date', dateStr);
        cell.setAttribute('title', filteredEvents.length ? (filteredEvents.length + ' kegiatan pada ' + d + ' ' + MONTHS_ID[currentCalMonth]) : ('Tanggal ' + d + ' ' + MONTHS_ID[currentCalMonth]));

        cell.innerHTML = '<span class="cal-cell__num">' + d + '</span>' +
          (filteredEvents.length ? '<span class="cal-cell__dot"></span>' : '');

        // Direct onclick on cell to open popup overlay modal
        (function(ds, events) {
          cell.onclick = function(e) {
            e.stopPropagation();
            openCalendarModal(ds, events);
          };
        })(dateStr, allEventsOnDate);

        body.appendChild(cell);
      }
    }

    function renderHomeUpcomingEvents() {
      var grid = document.getElementById('homeUpcomingGrid');
      if (!grid) return;

      var todayStr = new Date().toISOString().split('T')[0];
      var upcoming = rawCalendarEvents.filter(function(ev) {
        return ev.tanggal >= todayStr && isEventMatchingFilter(ev, activeCalFilter);
      }).sort(function(a, b) {
        return new Date(a.tanggal) - new Date(b.tanggal);
      }).slice(0, 6);

      if (upcoming.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:1.5rem; color:#94A3B8; font-size:0.9rem;">Belum ada agenda mendatang untuk kategori ini.</div>';
        return;
      }

      grid.innerHTML = upcoming.map(function(ev) {
        var d = new Date(ev.tanggal);
        var dayNum = d.getDate();
        var monthStr = MONTHS_ID[d.getMonth()].substring(0, 3);
        var komsek = findKomsekInfo(ev);

        return '<div class="cal-upcoming__card" onclick="openCalendarModalDirect(\'' + ev.tanggal + '\')">' +
          '<div class="cal-upcoming__date">' +
            '<span class="cal-upcoming__day">' + dayNum + '</span>' +
            '<span class="cal-upcoming__month">' + monthStr + '</span>' +
          '</div>' +
          '<div class="cal-upcoming__info">' +
            '<span class="cal-modal-card__badge">' + (ev.kategori || 'Kegiatan') + '</span>' +
            '<h4>' + ev.judul + '</h4>' +
            '<p>' + (ev.waktu ? '⏰ ' + ev.waktu + ' &bull; ' : '') + (ev.desc || '') + '</p>' +
            (komsek ? '<a href="/komsek/' + komsek.slug + '" class="cal-komsek-link" onclick="event.stopPropagation()">Wadah ' + komsek.nama + ' &rarr;</a>' : '') +
          '</div>' +
        '</div>';
      }).join('');
    }

    function openCalendarModal(dateStr, events) {
      if (!dateStr) return;
      var parts = dateStr.split('-');
      var y = parseInt(parts[0], 10);
      var m = parseInt(parts[1], 10) - 1;
      var d = parseInt(parts[2], 10);
      var dateObj = new Date(y, m, d);

      var dayName = DAYS_ID[dateObj.getDay()];
      var monthName = MONTHS_ID[m];
      var formattedTitle = dayName + ', ' + d + ' ' + monthName + ' ' + y;

      var titleModal = document.getElementById('calModalDate');
      if (titleModal) titleModal.textContent = formattedTitle;

      var modalBody = document.getElementById('calModalBody');
      if (modalBody) {
        if (events && events.length > 0) {
          modalBody.innerHTML = events.map(function(ev) {
            var komsek = findKomsekInfo(ev);
            return '<div class="cal-modal-card">' +
              '<div class="cal-modal-card__header">' +
                '<span class="cal-modal-card__badge">' + (ev.kategori || 'Kegiatan') + '</span>' +
                (ev.waktu ? '<span class="cal-modal-card__time">⏰ ' + ev.waktu + '</span>' : '') +
              '</div>' +
              '<h4 class="cal-modal-card__title">' + ev.judul + '</h4>' +
              '<p class="cal-modal-card__desc">' + (ev.desc || 'Tidak ada deskripsi tambahan.') + '</p>' +
              (komsek ? '<a href="/komsek/' + komsek.slug + '" class="cal-komsek-link" style="margin-top:10px;">🌟 Lihat Halaman ' + komsek.nama + ' &rarr;</a>' : '') +
            '</div>';
          }).join('');
        } else {
          modalBody.innerHTML = '<div class="cal-modal-empty">' +
            '<div class="cal-modal-empty__icon">📅</div>' +
            '<h4>Tidak Ada Agenda Khusus</h4>' +
            '<p>Belum ada jadwal ibadah atau kegiatan khusus yang tercatat pada tanggal ini.</p>' +
          '</div>';
        }
      }

      var modal = document.getElementById('calModal');
      if (modal) {
        modal.style.display = 'flex';
        void modal.offsetHeight;
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function openCalendarModalDirect(dateStr) {
      var dayEvents = rawCalendarEvents.filter(function(e) { return e.tanggal === dateStr; });
      openCalendarModal(dateStr, dayEvents);
    }

    function closeCalModal() {
      var modal = document.getElementById('calModal');
      if (modal) {
        modal.classList.remove('active');
        setTimeout(function() {
          if (!modal.classList.contains('active')) {
            modal.style.display = 'none';
          }
        }, 250);
      }
      document.body.style.overflow = '';
    }

    window.openCalendarModal = openCalendarModal;
    window.openCalendarModalDirect = openCalendarModalDirect;
    window.closeCalModal = closeCalModal;
    window.setCalendarFilter = setCalendarFilter;

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeNewsDetail();
        closeCalModal();
      }
    });

    // Initialize calendar on page load
    if (document.readyState === 'complete') {
      initHomeCalendar();
    } else {
      window.addEventListener('load', initHomeCalendar);
    }
  </script>
</body>
</html>




