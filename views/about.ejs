<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <meta name="description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= general.siteUrl || 'https://aminhermon.org' %>/about">
  <title>Tentang Gereja — <%= general.churchName %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Tentang Gereja — <%= general.churchName %>">
  <meta property="og:description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta property="og:url" content="<%= general.siteUrl || 'https://aminhermon.org' %>/about">
  <meta property="og:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= about.hero.bgImage %>">
  <meta property="og:site_name" content="<%= general.churchName %>">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Tentang Gereja — <%= general.churchName %>">
  <meta name="twitter:description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta name="twitter:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= about.hero.bgImage %>">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Tentang <%= general.churchName %>",
    "description": "<%= about.sejarah.content.split('\\n')[0] %>",
    "url": "<%= general.siteUrl || 'https://aminhermon.org' %>/about",
    "mainEntity": {
      "@type": "Church",
      "name": "<%= general.churchName %>",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bekasi",
        "addressRegion": "Jawa Barat",
        "addressCountry": "ID"
      }
    }
  }
  </script>

  <!-- Preload: Hero Image -->
  <link rel="preload" as="image" href="<%= about.hero.bgImage %>" fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="/css/style.min.css?v=25">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body>
  <%- include('partials/skeleton') %>
  <%- include('partials/navbar') %>
  <!-- ========== HERO ========== -->
  <section class="hero hero--sub" id="hero-about">
    <div class="hero__bg"><img src="<%= about.hero.bgImage.startsWith('/') ? about.hero.bgImage : '/' + about.hero.bgImage %>" alt="Tentang Gereja" loading="eager" width="1280" height="720" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/church-interior.png';"></div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__eyebrow">Tentang Gereja</div>
      <h1><%- about.hero.titleHTML %></h1>
      <p class="hero__subtitle"><%= about.hero.subtitle %></p>
    </div>
  </section>

  <!-- ========== SEJARAH (HERITAGE & JOURNEY) ========== -->
  <section class="section-sejarah" id="sejarah">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <span class="sejarah-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          Perjalanan Iman & Kasih
        </span>
        <h2><%= about.sejarah.title || 'Sejarah Gereja' %></h2>
        <span class="gold-line"></span>
        <p style="color: rgba(255,255,255,0.7); max-width: 680px; margin: 0.8rem auto 0; font-size: 1.05rem;">Melihat jejak anugerah Tuhan yang menuntun langkah kami dari sebuah persekutuan sederhana hingga menjadi rumah bagi setiap jiwa.</p>
      </div>

      <!-- Story Grid: Primary Narrative & Visual Card -->
      <div class="sejarah-story-grid">
        <!-- Left: Storytelling Card -->
        <div class="sejarah-story-card" data-aos="fade-right">
          <h3>Dari Sebuah Kerinduan Kecil Menjadi Berkat bagi Kota</h3>
          <% about.sejarah.content.split('\n\n').forEach(function(p) { %>
            <p class="sejarah-story-para"><%= p %></p>
          <% }); %>

          <div class="sejarah-verse-box">
            <blockquote>"Bukan karena kuat dan bukan karena gagah, melainkan oleh Roh-Ku, firman TUHAN semesta alam."</blockquote>
            <cite>Zakharia 4:6</cite>
          </div>
        </div>

        <!-- Right: Visual Heritage Showcase -->
        <div class="sejarah-visual" data-aos="fade-left">
          <img src="/assets/images/church-interior.png" alt="<%= general.churchName %>" class="sejarah-visual-img" onerror="this.onerror=null; this.src='/assets/images/church-hero.png';">
          <div class="sejarah-visual-overlay"></div>
          
          <div class="sejarah-floating-badge">
            <div class="sejarah-stat-item">
              <div class="sejarah-stat-num">13+</div>
              <div class="sejarah-stat-label">Wadah KomSek</div>
            </div>
            <div class="sejarah-stat-sep"></div>
            <div class="sejarah-stat-item">
              <div class="sejarah-stat-num">100%</div>
              <div class="sejarah-stat-label">Bagi Kristus</div>
            </div>
            <div class="sejarah-stat-sep"></div>
            <div class="sejarah-stat-item">
              <div class="sejarah-stat-num">Kasih</div>
              <div class="sejarah-stat-label">Semua Jiwa</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline: Jejak Langkah Pelayanan -->
      <div class="sejarah-timeline">
        <div class="sejarah-timeline-header" data-aos="fade-up">
          <span class="sejarah-tag" style="margin-bottom: 0.8rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            Tonggak Sejarah
          </span>
          <h3>Jejak Langkah Anugerah Tuhan</h3>
          <p>Bagaimana Tuhan merajut setiap babak pertumbuhan jemaat kami dalam kasih, doa, dan kesetiaan.</p>
        </div>

        <div class="sejarah-timeline-grid">
          <!-- Milestone 1 -->
          <div class="sejarah-milestone-card" data-aos="fade-up" data-aos-delay="50">
            <div class="sejarah-milestone-icon">🌱</div>
            <span class="sejarah-milestone-tag">Awal Mula</span>
            <h4 class="sejarah-milestone-heading">Benih Doa & Persekutuan</h4>
            <p class="sejarah-milestone-desc">Berawal dari persekutuan doa keluarga sederhana yang rindu berakar dalam kebenaran Firman dan saling melayani dalam ketulusan kasih.</p>
          </div>

          <!-- Milestone 2 -->
          <div class="sejarah-milestone-card" data-aos="fade-up" data-aos-delay="100">
            <div class="sejarah-milestone-icon">👥</div>
            <span class="sejarah-milestone-tag">Pertumbuhan</span>
            <h4 class="sejarah-milestone-heading">Wadah Komisi & Sektor</h4>
            <p class="sejarah-milestone-desc">Tuhan melipatgandakan jemaat sehingga dibentuk Komisi Kategorial (Anak, Pemuda, Perempuan, Bapak) serta pemekaran sektor pelayanan wilayah.</p>
          </div>

          <!-- Milestone 3 -->
          <div class="sejarah-milestone-card" data-aos="fade-up" data-aos-delay="150">
            <div class="sejarah-milestone-icon">⛪</div>
            <span class="sejarah-milestone-tag">Penetapan</span>
            <h4 class="sejarah-milestone-heading">Gedung Ibadah di Bekasi</h4>
            <p class="sejarah-milestone-desc">Berdirinya rumah peribadahan di Jatimelati, Pondok Melati, Bekasi sebagai altar penyembahan bersama dan pusat pelayanan kasih bagi masyarakat.</p>
          </div>

          <!-- Milestone 4 -->
          <div class="sejarah-milestone-card" data-aos="fade-up" data-aos-delay="200">
            <div class="sejarah-milestone-icon">🕊️</div>
            <span class="sejarah-milestone-tag">Masa Depan</span>
            <h4 class="sejarah-milestone-heading">Terus Berdampak bagi Jiwa</h4>
            <p class="sejarah-milestone-desc">Terus melangkah dengan visi inklusif, relevan dengan generasi muda, serta menjadi saluran berkat dan harapan bagi kota dan bangsa.</p>
          </div>
        </div>
      </div>

      <!-- Heritage Pillars: Nilai yang Diwarisi -->
      <div class="sejarah-pillars" data-aos="fade-up" data-aos-delay="100">
        <div class="sejarah-pillar-card">
          <div class="sejarah-pillar-icon">📖</div>
          <div class="sejarah-pillar-text">
            <h4>Alkitabiah & Berpusat pada Kristus</h4>
            <p>Setiap pengajaran dan ibadah berakar teguh pada Firman Allah yang hidup dan berkuasa mengubahkan.</p>
          </div>
        </div>
        <div class="sejarah-pillar-card">
          <div class="sejarah-pillar-icon">🤝</div>
          <div class="sejarah-pillar-text">
            <h4>Keluarga yang Menyambut Siapa Saja</h4>
            <p>Bukan sekadar institusi, tetapi rumah dan persekutuan hangat di mana setiap orang diterima apa adanya.</p>
          </div>
        </div>
        <div class="sejarah-pillar-card">
          <div class="sejarah-pillar-icon">✨</div>
          <div class="sejarah-pillar-text">
            <h4>Garam & Terang bagi Masyarakat</h4>
            <p>Menghadirkan kasih nyata Kristus lewat aksi kepedulian sosial, doa, dan pelayanan bagi sesama.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========== VISI & MISI ========== -->
  <section class="section section--off-white" id="visi-misi">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Visi & <span class="text-gold">Misi</span></h2>
        <span class="gold-line"></span>
      </div>
      <div class="vm-grid" data-aos="fade-up">
        <div class="vm-card">
          <div class="vm-card__label">Visi</div>
          <h3>Terang Kristus bagi Setiap Keluarga</h3>
          <p><%= about.visiMisi.visi %></p>
        </div>
        <div class="vm-card">
          <div class="vm-card__label">Misi</div>
          <h3>Mewujudkan Panggilan Ilahi</h3>
          <ul>
            <% about.visiMisi.misiList.forEach(function(m) { %>
              <li><%= m %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROFIL PEMIMPIN ========== -->
  <section class="section" id="pemimpin">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>STRUKTUR PENGURUS<br><span class="text-gold">GEREJA AMIN HERMON</span></h2>
        <span class="gold-line"></span>
        <p>Para pelayan dan pengurus yang dipercayakan untuk menggembalakan dan melayani jemaat.</p>
      </div>

      <%
        function formatLeaderName(raw) {
          if (!raw) return '';
          var match = raw.match(/^(.*?)\s*(\(.*?\))\s*$/);
          if (match) {
            var main = match[1].trim();
            var alias = match[2].trim();
            alias = alias.replace(/^\(A\.\s*/i, '(Ama ').replace(/^\(I\.\s*/i, '(Ina ');
            return '<span class="leader-name__main">' + main + '</span><span class="leader-name__alias" style="color: var(--gold, #C8A951) !important;">' + alias + '</span>';
          }
          if (raw.includes('\n')) {
            var lines = raw.split('\n').map(function(s){ return s.trim(); }).filter(Boolean);
            return '<span class="leader-name__main">' + lines[0] + '</span><span class="leader-name__alias" style="color: var(--gold, #C8A951) !important;">' + lines.slice(1).join(' ') + '</span>';
          }
          return '<span class="leader-name__main">' + raw + '</span>';
        }
      %>

      <!-- Pendeta -->
      <h3 class="sub-section-title" data-aos="fade-up">Pendeta</h3>
      <div class="leaders-grid leaders-grid--2" data-aos="fade-up">
        <% about.pemimpin.pendeta.forEach(function(p) { %>
        <div class="leader-card leader-card--featured leader-card--clickable"
             data-img="<%= p.image || '' %>"
             data-name="<%= p.name %>"
             data-role="<%= p.role %>">
          <div class="leader-card__img" style="background: linear-gradient(135deg, var(--navy), var(--navy-light)); display: flex; align-items: center; justify-content: center;">
            <% if (p.image) { %>
              <img src="/<%= p.image %>" alt="<%= p.name %>" width="200" height="200" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <% } %>
          </div>
          <div class="leader-card__info">
            <h4><%- formatLeaderName(p.name) %></h4>
            <span><%= p.role %></span>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Pengurus Harian -->
      <h3 class="sub-section-title" data-aos="fade-up">Pengurus Harian</h3>
      <!-- Baris 1: Ketua (3 kartu) -->
      <div class="pengurus-row pengurus-row--3" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(0, 3).forEach(function(pg) { %>
        <div class="leader-card leader-card--sm leader-card--clickable"
             data-img="<%= pg.image ? '/' + pg.image : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <div class="leader-card__img">
            <% if (pg.image) { %>
              <img src="/<%= pg.image %>" alt="<%= pg.name %>" width="200" height="200" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" opacity="0.7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <% } %>
          </div>
          <div class="leader-card__info">
            <h4><%- formatLeaderName(pg.name) %></h4>
            <span><%= pg.role %></span>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Baris 2: Sekretaris (2 kartu) -->
      <div class="pengurus-row pengurus-row--2" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(3, 5).forEach(function(pg) { %>
        <div class="leader-card leader-card--sm leader-card--clickable"
             data-img="<%= pg.image ? '/' + pg.image : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <div class="leader-card__img">
            <% if (pg.image) { %>
              <img src="/<%= pg.image %>" alt="<%= pg.name %>" width="200" height="200" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" opacity="0.7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <% } %>
          </div>
          <div class="leader-card__info">
            <h4><%- formatLeaderName(pg.name) %></h4>
            <span><%= pg.role %></span>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Baris 3: Bendahara (2 kartu) -->
      <div class="pengurus-row pengurus-row--2" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(5, 7).forEach(function(pg) { %>
        <div class="leader-card leader-card--sm leader-card--clickable"
             data-img="<%= pg.image ? '/' + pg.image : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <div class="leader-card__img">
            <% if (pg.image) { %>
              <img src="/<%= pg.image %>" alt="<%= pg.name %>" width="200" height="200" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" opacity="0.7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <% } %>
          </div>
          <div class="leader-card__info">
            <h4><%- formatLeaderName(pg.name) %></h4>
            <span><%= pg.role %></span>
          </div>
        </div>
        <% }); %>
      </div>

      <!-- Majelis Jemaat -->
      <h3 class="sub-section-title" data-aos="fade-up">Majelis Jemaat</h3>
      <div class="majelis-photo-grid" data-aos="fade-up">
        <% about.pemimpin.majelis.forEach(function(m, i) { %>
        <div class="leader-card leader-card--sm leader-card--clickable"
             data-img="<%= m.image ? '/' + m.image : '' %>"
             data-name="<%= m.name %>"
             data-role="<%= m.role || 'Majelis' %>">
          <div class="leader-card__img">
            <% if (m.image) { %>
              <img src="/<%= m.image %>" alt="<%= m.name %>" width="200" height="200" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" opacity="0.7"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <% } %>
          </div>
          <div class="leader-card__info">
            <h4><%- formatLeaderName(m.name) %></h4>
            <span><%= m.role || 'Majelis' %></span>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Photo Modal -->
  <div class="photo-modal" id="photoModal">
    <div class="photo-modal__overlay" id="photoModalOverlay"></div>
    <div class="photo-modal__card">
      <button class="photo-modal__close" id="photoModalClose">&times;</button>
      <div class="photo-modal__img-wrapper">
        <img id="photoModalImg" src="" alt="Enlarged Photo">
      </div>
      <div class="photo-modal__info">
        <h3 id="photoModalName"></h3>
        <p id="photoModalRole"></p>
      </div>
    </div>
  </div>

  <script>
    // Event delegation for all clickable leader cards
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.leader-card--clickable').forEach(function(card) {
        card.style.cursor = 'pointer';
        card.addEventListener('click', function() {
          var img = this.getAttribute('data-img');
          var name = this.getAttribute('data-name');
          var role = this.getAttribute('data-role');
          document.getElementById('photoModalImg').src = img || '';
          document.getElementById('photoModalImg').style.display = img ? 'block' : 'none';
          var modalName = document.getElementById('photoModalName');
          var match = name ? name.match(/^(.*?)\s*(\(.*?\))\s*$/) : null;
          if (match) {
            var alias = match[2].trim().replace(/^\(A\.\s*/i, '(Ama ').replace(/^\(I\.\s*/i, '(Ina ');
            modalName.innerHTML = '<span class="photo-modal__main-name">' + match[1].trim() + '</span><span class="photo-modal__alias-name">' + alias + '</span>';
          } else {
            modalName.textContent = name;
          }
          document.getElementById('photoModalRole').textContent = role;
          document.getElementById('photoModal').classList.add('active');
        });
      });

      document.getElementById('photoModalOverlay').addEventListener('click', function() {
        document.getElementById('photoModal').classList.remove('active');
      });
      document.getElementById('photoModalClose').addEventListener('click', function() {
        document.getElementById('photoModal').classList.remove('active');
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          document.getElementById('photoModal').classList.remove('active');
        }
      });
    });
  </script>

  <%- include('partials/footer') %>
  <script src="/js/main.min.js?v=10" defer></script>
</body>
</html>




