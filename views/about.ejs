<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <meta name="description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= general.siteUrl || 'https://aminhermon.org' %>/about">
  <title>Tentang Gereja — <%= general.churchName %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Tentang Gereja — <%= general.churchName %>">
  <meta property="og:description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta property="og:url" content="<%= general.siteUrl || 'https://aminhermon.org' %>/about">
  <meta property="og:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= about.hero.bgImage %>">
  <meta property="og:site_name" content="<%= general.churchName %>">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Tentang Gereja — <%= general.churchName %>">
  <meta name="twitter:description" content="Profil, sejarah, visi misi, dan pemimpin <%= general.churchName %>.">
  <meta name="twitter:image" content="<%= general.siteUrl || 'https://aminhermon.org' %>/<%= about.hero.bgImage %>">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "Tentang <%= general.churchName %>",
    "description": "<%= about.sejarah.content.split('\\n')[0] %>",
    "url": "<%= general.siteUrl || 'https://aminhermon.org' %>/about",
    "mainEntity": {
      "@type": "Church",
      "name": "<%= general.churchName %>",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Bekasi",
        "addressRegion": "Jawa Barat",
        "addressCountry": "ID"
      }
    }
  }
  </script>

  <!-- Preload: Hero Image -->
  <link rel="preload" as="image" href="<%= about.hero.bgImage %>" fetchpriority="high">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link rel="stylesheet" href="/css/style.min.css?v=28">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body>
  <%- include('partials/skeleton') %>
  <%- include('partials/navbar') %>
  <!-- ========== HERO ========== -->
  <section class="hero hero--sub" id="hero-about">
    <div class="hero__bg"><img src="<%= imgUrl(about.hero.bgImage, '/assets/images/church-interior.png') %>" alt="Tentang Gereja" loading="eager" width="1280" height="720" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/church-interior.png';"></div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__eyebrow">Tentang Gereja</div>
      <h1><%- about.hero.titleHTML %></h1>
      <p class="hero__subtitle"><%= about.hero.subtitle %></p>
    </div>
  </section>

  <!-- ========== SEJARAH ========== -->
  <section class="section" id="sejarah">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2><%= about.sejarah.title %></h2>
        <span class="gold-line"></span>
      </div>
      <div class="sejarah-content-box" data-aos="fade-up">
        <% about.sejarah.content.split('\n\n').forEach(function(p) { %>
          <p class="sejarah-p"><%= p %></p>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ========== VISI & MISI ========== -->
  <section class="section section--off-white" id="visi-misi">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Visi & <span class="text-gold">Misi</span></h2>
        <span class="gold-line"></span>
      </div>
      <div class="vm-grid" data-aos="fade-up">
        <div class="vm-card">
          <div class="vm-card__label">Visi</div>
          <h3>Terang Kristus bagi Setiap Keluarga</h3>
          <p><%= about.visiMisi.visi %></p>
        </div>
        <div class="vm-card">
          <div class="vm-card__label">Misi</div>
          <h3>Mewujudkan Panggilan Ilahi</h3>
          <ul>
            <% about.visiMisi.misiList.forEach(function(m) { %>
              <li><%= m %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== PROFIL PEMIMPIN ========== -->
  <section class="section" id="pemimpin">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>STRUKTUR PENGURUS<br><span class="text-gold">GEREJA AMIN HERMON</span></h2>
        <span class="gold-line"></span>
        <p>Para pelayan dan pengurus yang dipercayakan untuk menggembalakan dan melayani jemaat.</p>
      </div>

      <%
        function formatLeaderName(raw) {
          if (!raw) return '';
          var match = raw.match(/^(.*?)\s*(\(.*?\))\s*$/);
          if (match) {
            var main = match[1].trim();
            var alias = match[2].trim();
            alias = alias.replace(/^\(A\.\s*/i, '(Ama ').replace(/^\(I\.\s*/i, '(Ina ');
            return '<span class="leader-name__main">' + main + '</span><span class="leader-name__alias" style="color: var(--gold, #C8A951) !important;">' + alias + '</span>';
          }
          if (raw.includes('\n')) {
            var lines = raw.split('\n').map(function(s){ return s.trim(); }).filter(Boolean);
            return '<span class="leader-name__main">' + lines[0] + '</span><span class="leader-name__alias" style="color: var(--gold, #C8A951) !important;">' + lines.slice(1).join(' ') + '</span>';
          }
          return '<span class="leader-name__main">' + raw + '</span>';
        }
      %>

      <!-- Pendeta — Premium Hero Card -->
      <h3 class="sub-section-title" data-aos="fade-up">Pendeta</h3>
      <% var pastor = about.pemimpin.pendeta[0]; %>
      <% if (pastor) { %>
      <div class="pastor-hero" data-aos="fade-up">
        <div class="pastor-hero__card leader-card--clickable"
             data-img="<%= pastor.image ? imgUrl(pastor.image) : '' %>"
             data-name="<%= pastor.name %>"
             data-role="<%= pastor.role %>">
          <!-- Decorative corner accents -->
          <span class="pastor-hero__corner pastor-hero__corner--tl"></span>
          <span class="pastor-hero__corner pastor-hero__corner--tr"></span>
          <span class="pastor-hero__corner pastor-hero__corner--bl"></span>
          <span class="pastor-hero__corner pastor-hero__corner--br"></span>

          <div class="pastor-hero__photo">
            <div class="pastor-hero__photo-frame">
              <% if (pastor.image) { %>
                <img src="<%= imgUrl(pastor.image) %>" alt="<%= pastor.name %>" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
              <% } else { %>
                <div class="pastor-hero__placeholder">
                  <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
              <% } %>
            </div>
          </div>

          <div class="pastor-hero__info">
            <div class="pastor-hero__badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L14.09 8.26L21 9.27L16.18 14.14L17.18 21.02L12 18.27L6.82 21.02L7.82 14.14L3 9.27L9.91 8.26L12 2Z"/></svg>
              Gembala Jemaat
            </div>
            <h4 class="pastor-hero__name"><%- formatLeaderName(pastor.name) %></h4>
            <span class="pastor-hero__role"><%= pastor.role %></span>
            <div class="pastor-hero__divider"></div>
            <p class="pastor-hero__verse">"Akulah gembala yang baik. Gembala yang baik memberikan nyawanya bagi domba-dombanya."</p>
            <span class="pastor-hero__verse-ref">— Yohanes 10:11</span>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Pengurus Harian -->
      <h3 class="sub-section-title" data-aos="fade-up">Pengurus Harian</h3>

      <!-- Baris 1: Ketua (3 kartu) -->
      <div class="prem-grid prem-grid--3" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(0, 3).forEach(function(pg) { %>
        <div class="prem-card leader-card--clickable"
             data-img="<%= pg.image ? imgUrl(pg.image) : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <span class="prem-card__accent"></span>
          <div class="prem-card__photo">
            <% if (pg.image) { %>
              <img src="<%= imgUrl(pg.image) %>" alt="<%= pg.name %>" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <div class="prem-card__avatar">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            <% } %>
          </div>
          <div class="prem-card__body">
            <span class="prem-card__badge"><%= pg.role %></span>
            <h4 class="prem-card__name"><%- formatLeaderName(pg.name) %></h4>
          </div>
          <div class="prem-card__shimmer"></div>
        </div>
        <% }); %>
      </div>

      <!-- Baris 2: Sekretaris (2 kartu) -->
      <div class="prem-grid prem-grid--2" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(3, 5).forEach(function(pg) { %>
        <div class="prem-card leader-card--clickable"
             data-img="<%= pg.image ? imgUrl(pg.image) : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <span class="prem-card__accent"></span>
          <div class="prem-card__photo">
            <% if (pg.image) { %>
              <img src="<%= imgUrl(pg.image) %>" alt="<%= pg.name %>" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <div class="prem-card__avatar">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            <% } %>
          </div>
          <div class="prem-card__body">
            <span class="prem-card__badge"><%= pg.role %></span>
            <h4 class="prem-card__name"><%- formatLeaderName(pg.name) %></h4>
          </div>
          <div class="prem-card__shimmer"></div>
        </div>
        <% }); %>
      </div>

      <!-- Baris 3: Bendahara (2 kartu) -->
      <div class="prem-grid prem-grid--2" data-aos="fade-up">
        <% about.pemimpin.pengurus.slice(5, 7).forEach(function(pg) { %>
        <div class="prem-card leader-card--clickable"
             data-img="<%= pg.image ? imgUrl(pg.image) : '' %>"
             data-name="<%= pg.name %>"
             data-role="<%= pg.role %>">
          <span class="prem-card__accent"></span>
          <div class="prem-card__photo">
            <% if (pg.image) { %>
              <img src="<%= imgUrl(pg.image) %>" alt="<%= pg.name %>" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <div class="prem-card__avatar">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            <% } %>
          </div>
          <div class="prem-card__body">
            <span class="prem-card__badge"><%= pg.role %></span>
            <h4 class="prem-card__name"><%- formatLeaderName(pg.name) %></h4>
          </div>
          <div class="prem-card__shimmer"></div>
        </div>
        <% }); %>
      </div>

      <!-- Majelis Jemaat -->
      <h3 class="sub-section-title" data-aos="fade-up">Majelis Jemaat</h3>
      <div class="prem-grid prem-grid--auto" data-aos="fade-up">
        <% about.pemimpin.majelis.forEach(function(m, i) { %>
        <div class="prem-card prem-card--compact leader-card--clickable"
             data-img="<%= m.image ? imgUrl(m.image) : '' %>"
             data-name="<%= m.name %>"
             data-role="<%= m.role || 'Majelis' %>">
          <span class="prem-card__accent"></span>
          <div class="prem-card__photo">
            <% if (m.image) { %>
              <img src="<%= imgUrl(m.image) %>" alt="<%= m.name %>" loading="lazy" onerror="this.onerror=null; this.src='/assets/images/logo-gereja-amin-3d.png';">
            <% } else { %>
              <div class="prem-card__avatar">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--gold-light)" stroke-width="1" opacity="0.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
            <% } %>
          </div>
          <div class="prem-card__body">
            <span class="prem-card__badge prem-card__badge--sm"><%= m.role || 'Majelis' %></span>
            <h4 class="prem-card__name"><%- formatLeaderName(m.name) %></h4>
          </div>
          <div class="prem-card__shimmer"></div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Photo Modal -->
  <div class="photo-modal" id="photoModal">
    <div class="photo-modal__overlay" id="photoModalOverlay"></div>
    <div class="photo-modal__card">
      <button class="photo-modal__close" id="photoModalClose">&times;</button>
      <div class="photo-modal__img-wrapper">
        <img id="photoModalImg" src="" alt="Enlarged Photo">
      </div>
      <div class="photo-modal__info">
        <h3 id="photoModalName"></h3>
        <p id="photoModalRole"></p>
      </div>
    </div>
  </div>

  <script>
    // Event delegation for all clickable leader cards
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.leader-card--clickable').forEach(function(card) {
        card.style.cursor = 'pointer';
        card.addEventListener('click', function() {
          var img = this.getAttribute('data-img');
          var name = this.getAttribute('data-name');
          var role = this.getAttribute('data-role');
          document.getElementById('photoModalImg').src = img || '';
          document.getElementById('photoModalImg').style.display = img ? 'block' : 'none';
          var modalName = document.getElementById('photoModalName');
          var match = name ? name.match(/^(.*?)\s*(\(.*?\))\s*$/) : null;
          if (match) {
            var alias = match[2].trim().replace(/^\(A\.\s*/i, '(Ama ').replace(/^\(I\.\s*/i, '(Ina ');
            modalName.innerHTML = '<span class="photo-modal__main-name">' + match[1].trim() + '</span><span class="photo-modal__alias-name">' + alias + '</span>';
          } else {
            modalName.textContent = name;
          }
          document.getElementById('photoModalRole').textContent = role;
          document.getElementById('photoModal').classList.add('active');
        });
      });

      document.getElementById('photoModalOverlay').addEventListener('click', function() {
        document.getElementById('photoModal').classList.remove('active');
      });
      document.getElementById('photoModalClose').addEventListener('click', function() {
        document.getElementById('photoModal').classList.remove('active');
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          document.getElementById('photoModal').classList.remove('active');
        }
      });
    });
  </script>

  <%- include('partials/footer') %>
  <script src="/js/main.min.js?v=15" defer></script>
</body>
</html>




