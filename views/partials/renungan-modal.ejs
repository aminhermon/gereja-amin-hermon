<!-- ========== POPUP OVERLAY MODAL INTERAKTIF RENUNGAN HARIAN ========== -->
<div class="renungan-modal" id="renunganModal" role="dialog" aria-modal="true" aria-labelledby="renunganModalTitle" data-theme="dark" data-fontsize="md">
  <div class="renungan-modal__backdrop" onclick="window.closeRenunganModal()"></div>
  <div class="renungan-modal__dialog">
    <!-- Header -->
    <div class="renungan-modal__header">
      <div class="renungan-modal__header-left">
        <span class="renungan-modal__eyebrow">📖 Renungan Harian Gereja AMIN Hermon</span>
        <h3 class="renungan-modal__title" id="renunganModalTitle">Judul Renungan</h3>
        <div class="renungan-modal__meta">
          <span id="renunganModalDate">🗓️ Tanggal</span>
          <span>•</span>
          <span id="renunganModalRef" style="color: var(--gold); font-weight: 600;">📖 Ayat</span>
        </div>
      </div>
      <button type="button" class="renungan-modal__close" onclick="window.closeRenunganModal()" aria-label="Tutup renungan">&times;</button>
    </div>

    <!-- Interactive Reader Toolbar -->
    <div class="renungan-reader-toolbar">
      <!-- TTS Audio Player -->
      <div class="renungan-toolbar-group">
        <button type="button" class="renungan-tool-btn" id="btnTtsPlay" onclick="window.toggleRenunganAudio()" title="Dengarkan pembacaan renungan ini">
          <span id="ttsIcon">▶️</span>
          <span id="ttsLabel">Dengarkan</span>
          <div class="renungan-soundwave" id="ttsWave" style="display: none;">
            <span></span><span></span><span></span>
          </div>
        </button>
      </div>

      <!-- Font Size Controller -->
      <div class="renungan-toolbar-group">
        <span style="font-size: 0.75rem; opacity: 0.7; margin-right: 2px;">Teks:</span>
        <button type="button" class="renungan-tool-btn" id="btnFontSm" onclick="window.setRenunganFontSize('sm')" title="Ukuran teks kecil">A-</button>
        <button type="button" class="renungan-tool-btn active" id="btnFontMd" onclick="window.setRenunganFontSize('md')" title="Ukuran teks sedang">A</button>
        <button type="button" class="renungan-tool-btn" id="btnFontLg" onclick="window.setRenunganFontSize('lg')" title="Ukuran teks besar">A+</button>
      </div>

      <!-- Theme Switcher -->
      <div class="renungan-toolbar-group">
        <span style="font-size: 0.75rem; opacity: 0.7; margin-right: 2px;">Tema:</span>
        <button type="button" class="renungan-tool-btn active" id="btnThemeDark" onclick="window.setRenunganTheme('dark')" title="Mode Gelap / Malam">🌙</button>
        <button type="button" class="renungan-tool-btn" id="btnThemeSepia" onclick="window.setRenunganTheme('sepia')" title="Mode Kertas Sepia">📜</button>
        <button type="button" class="renungan-tool-btn" id="btnThemeLight" onclick="window.setRenunganTheme('light')" title="Mode Terang">☀️</button>
      </div>

      <!-- Share & Copy -->
      <div class="renungan-toolbar-group">
        <button type="button" class="renungan-tool-btn" onclick="window.shareRenunganWhatsApp()" title="Bagikan renungan ke WhatsApp">📲 WA</button>
        <button type="button" class="renungan-tool-btn" onclick="window.copyRenunganText()" title="Salin isi renungan">📋 Salin</button>
      </div>
    </div>

    <!-- Body / Content -->
    <div class="renungan-modal__body" id="renunganModalBody">
      <!-- Scripture Quote Box -->
      <div class="renungan-modal__verse-box">
        <div class="renungan-modal__verse-text" id="renunganModalVerseText">"..."</div>
        <span class="renungan-modal__verse-ref" id="renunganModalVerseRef">-</span>
      </div>

      <!-- Main Text -->
      <div class="renungan-modal__text" id="renunganModalContent">
        ...
      </div>

      <!-- Prayer Meditation Box -->
      <div class="renungan-modal__prayer-box" id="renunganModalPrayerBox">
        <div class="renungan-modal__prayer-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Doa & Refleksi Hari Ini
        </div>
        <p id="renunganModalPrayer" style="margin: 0; font-style: italic; opacity: 0.9;">
          "Tuhan Yesus, terima kasih atas firman-Mu yang hidup. Mampukan kami untuk melakukannya dalam setiap langkah hidup kami sehari-hari. Amin."
        </p>
      </div>

      <!-- Congregation Reactions -->
      <div class="renungan-reactions-section">
        <div class="renungan-reactions-title">Bagaimana firman Tuhan ini menyapa Anda?</div>
        <div class="renungan-reactions-grid">
          <button type="button" class="renungan-react-btn" data-type="amin" onclick="window.handleRenunganReaction('amin')">
            <span>🙏</span> <span>Amin</span> <span class="renungan-react-count" id="count_amin">0</span>
          </button>
          <button type="button" class="renungan-react-btn" data-type="diberkati" onclick="window.handleRenunganReaction('diberkati')">
            <span>❤️</span> <span>Diberkati</span> <span class="renungan-react-count" id="count_diberkati">0</span>
          </button>
          <button type="button" class="renungan-react-btn" data-type="menguatkan" onclick="window.handleRenunganReaction('menguatkan')">
            <span>💡</span> <span>Menguatkan</span> <span class="renungan-react-count" id="count_menguatkan">0</span>
          </button>
          <button type="button" class="renungan-react-btn" data-type="bersyukur" onclick="window.handleRenunganReaction('bersyukur')">
            <span>✨</span> <span>Bersyukur</span> <span class="renungan-react-count" id="count_bersyukur">0</span>
          </button>
        </div>
      </div>

      <!-- Personal Reflection Journal -->
      <div class="renungan-notepad-section">
        <div class="renungan-notepad-header">
          <h4 class="renungan-notepad-title">
            <span>📝</span> Catatan Refleksi Pribadi Saya
          </h4>
          <span class="renungan-notepad-status" id="notepadStatus">✓ Tersimpan di perangkat Anda</span>
        </div>
        <textarea class="renungan-notepad-textarea" id="renunganNoteInput" placeholder="Tuliskan apa yang Tuhan taruh di hati Anda hari ini atau doa komitmen Anda... (tersimpan otomatis & rahasia di perangkat Anda)" oninput="window.saveRenunganPersonalNote()"></textarea>
      </div>
    </div>
  </div>
</div>

<!-- Floating Toast Notification -->
<div class="renungan-toast" id="renunganToast">
  <span id="renunganToastMsg">Teks berhasil disalin!</span>
</div>
