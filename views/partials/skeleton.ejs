<!-- Loading Skeleton -->
<div class="skeleton-wrapper" id="loadingSkeleton">
  <!-- Skeleton Navbar -->
  <div class="skeleton-nav">
    <div class="skeleton-bone skeleton-nav__logo"></div>
    <div class="skeleton-nav__links">
      <div class="skeleton-bone skeleton-nav__link"></div>
      <div class="skeleton-bone skeleton-nav__link"></div>
      <div class="skeleton-bone skeleton-nav__link"></div>
      <div class="skeleton-bone skeleton-nav__link"></div>
      <div class="skeleton-bone skeleton-nav__link"></div>
    </div>
  </div>

  <!-- Skeleton Hero -->
  <div class="skeleton-hero">
    <div class="skeleton-bone skeleton-hero__eyebrow"></div>
    <div class="skeleton-bone skeleton-hero__title"></div>
    <div class="skeleton-bone skeleton-hero__subtitle"></div>
  </div>

  <!-- Skeleton Content -->
  <div class="skeleton-content">
    <div class="skeleton-bone skeleton-content__heading"></div>
    <div class="skeleton-bone skeleton-content__line skeleton-content__line--long"></div>
    <div class="skeleton-bone skeleton-content__line skeleton-content__line--med"></div>
    <div class="skeleton-bone skeleton-content__line skeleton-content__line--short"></div>

    <div class="skeleton-cards">
      <div class="skeleton-card">
        <div class="skeleton-bone skeleton-card__img"></div>
        <div class="skeleton-card__text">
          <div class="skeleton-bone skeleton-card__title"></div>
          <div class="skeleton-bone skeleton-card__sub"></div>
        </div>
      </div>
      <div class="skeleton-card">
        <div class="skeleton-bone skeleton-card__img"></div>
        <div class="skeleton-card__text">
          <div class="skeleton-bone skeleton-card__title"></div>
          <div class="skeleton-bone skeleton-card__sub"></div>
        </div>
      </div>
      <div class="skeleton-card">
        <div class="skeleton-bone skeleton-card__img"></div>
        <div class="skeleton-card__text">
          <div class="skeleton-bone skeleton-card__title"></div>
          <div class="skeleton-bone skeleton-card__sub"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
<script>
  window.addEventListener('load', function() {
    var skeleton = document.getElementById('loadingSkeleton');
    if (skeleton) {
      skeleton.classList.add('skeleton--hidden');
      setTimeout(function() { skeleton.remove(); }, 500);
    }
  });
</script>
