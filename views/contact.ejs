<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Hubungi <%= general.churchName %> untuk informasi lebih lanjut.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= general.siteUrl || 'https://aminhermon.org' %>/contact.html">
  <title>Hubungi Kami — <%= general.churchName %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Hubungi Kami — <%= general.churchName %>">
  <meta property="og:description" content="Hubungi <%= general.churchName %> untuk informasi lebih lanjut.">
  <meta property="og:url" content="<%= general.siteUrl || 'https://aminhermon.org' %>/contact.html">
  <meta property="og:site_name" content="<%= general.churchName %>">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Hubungi Kami — <%= general.churchName %>">
  <meta name="twitter:description" content="Hubungi <%= general.churchName %> untuk informasi lebih lanjut.">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Hubungi <%= general.churchName %>",
    "description": "Hubungi <%= general.churchName %> untuk informasi lebih lanjut.",
    "url": "<%= general.siteUrl || 'https://aminhermon.org' %>/contact.html"
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="css/style.min.css?v=10">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body>
  <%- include('partials/skeleton') %>
  <%- include('partials/navbar') %>
  <!-- ========== HERO ========== -->
  <section class="hero hero--sub" id="hero-contact">
    <div class="hero__bg"><img src="<%= contactFaq.hero.bgImage %>" alt="Hubungi Kami" loading="eager"></div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__eyebrow">Kontak</div>
      <h1><%- contactFaq.hero.titleHTML %></h1>
      <p class="hero__subtitle"><%= contactFaq.hero.subtitle %></p>
    </div>
  </section>



  <!-- ========== WHATSAPP CTA ========== -->
  <section class="section section--navy" id="whatsapp-cta">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Hubungi <span class="text-gold">Sekretariat</span></h2>
        <span class="gold-line"></span>
        <p>Punya pertanyaan lain? Kami siap membantu melalui WhatsApp.</p>
      </div>
      <div class="" data-aos="fade-up" style="text-align: center;">
        <a href="https://wa.me/<%= contactFaq.whatsapp.number %>?text=<%= encodeURIComponent(contactFaq.whatsapp.message) %>" target="_blank" rel="noopener" class="btn btn--whatsapp btn--lg" id="btn-wa-main">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.58-.5-.5-.68-.51-.18-.01-.38-.01-.58-.01s-.53.07-.8.38c-.28.3-1.06 1.03-1.06 2.52 0 1.49 1.08 2.92 1.23 3.12.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zm-5.42 7.4A9.87 9.87 0 0 1 7 20.14l-.36-.21-3.73.98.99-3.63-.24-.37a9.88 9.88 0 0 1-1.51-5.26c0-5.46 4.44-9.9 9.9-9.9 2.65 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9zm8.41-18.31A11.82 11.82 0 0 0 12.05.03C5.5.03.16 5.37.16 11.92c0 2.1.55 4.14 1.58 5.95L0 24l6.3-1.65a11.87 11.87 0 0 0 5.75 1.47c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41z"/></svg>
          <%= contactFaq.whatsapp.label %>
        </a>
        <p style="margin-top: 1.5rem; font-size: 0.9rem; opacity: 0.7; color: var(--gold-light);">Jam operasional Sekretariat: Senin–Sabtu, 09.00–16.00 WIB</p>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="js/main.min.js?v=3" defer></script>
</body>
</html>




