<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="shortcut icon" href="/favicon.ico">

  <meta name="description" content="Pertama kali ke <%= general.churchName %>? Kami siap menyambut Anda.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= general.siteUrl || 'https://aminhermon.org' %>/visit">
  <title>Baru di Sini? — <%= general.churchName %></title>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="Baru di Sini? — <%= general.churchName %>">
  <meta property="og:description" content="Pertama kali ke <%= general.churchName %>? Kami siap menyambut Anda.">
  <meta property="og:url" content="<%= general.siteUrl || 'https://aminhermon.org' %>/visit">
  <meta property="og:site_name" content="<%= general.churchName %>">
  <meta property="og:locale" content="id_ID">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Baru di Sini? — <%= general.churchName %>">
  <meta name="twitter:description" content="Pertama kali ke <%= general.churchName %>? Kami siap menyambut Anda.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.min.css?v=53">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body>
  <%- include('partials/skeleton') %>
  <%- include('partials/navbar') %>
  <!-- ========== HERO ========== -->
  <section class="hero hero--sub" id="hero-visit">
    <div class="hero__bg"><img src="<%= imgUrl(visit.hero.bgImage, '/assets/images/welcome-visitors.png') %>" alt="Selamat Datang" loading="eager" width="1280" height="720" style="width:100%;height:100%;object-fit:cover;" onerror="this.onerror=null; this.src='/assets/images/welcome-visitors.png';"></div>
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <div class="hero__eyebrow">Plan Your Visit</div>
      <h1><%- visit.hero.titleHTML %></h1>
      <p class="hero__subtitle"><%= visit.hero.subtitle %></p>
    </div>
  </section>

  <!-- ========== SAMBUTAN HANGAT ========== -->
  <section class="section" id="sambutan">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Selamat Datang di <span class="text-gold">Gereja Kami</span></h2>
        <span class="gold-line"></span>
      </div>
      <div class="" data-aos="fade-up" style="max-width: 800px; margin: 0 auto;">
        <p style="font-size: 1.1rem; line-height: 1.9; color: var(--text-light); text-align: center;">
          <%= visit.sambutan %>
        </p>
      </div>
    </div>
  </section>

  <!-- ========== JADWAL IBADAH ========== -->
  <section class="section section--off-white" id="jadwal">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Jadwal <span class="text-gold">Ibadah Minggu</span></h2>
        <span class="gold-line"></span>
        <p>Bergabunglah bersama kami setiap hari Minggu.</p>
      </div>
      <div class="jadwal-grid" data-aos="fade-up">
        <% visit.jadwalIbadah.forEach(function(jadwal) { %>
        <div class="jadwal-card">
          <div class="jadwal-card__time"><%= jadwal.jam %></div>
          <h3 class="jadwal-card__name"><%= jadwal.nama %></h3>
          <p class="jadwal-card__day"><%= jadwal.hari %></p>
          <p class="jadwal-card__desc"><%= jadwal.keterangan %></p>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ========== LOKASI ========== -->
  <section class="section" id="lokasi">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2><%= visit.lokasi.judul %></h2>
        <span class="gold-line"></span>
        <p><%= visit.lokasi.deskripsi %></p>
      </div>
      <div class="" data-aos="fade-up" style="text-align: center;">
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed/v1/search?q=<%= visit.lokasi.mapsQuery %>&key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8"
            allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="Lokasi Gereja di Google Maps"></iframe>
        </div>
        <p style="margin-top: 1rem; color: var(--text-light);"><%= visit.lokasi.alamat %></p>
        <a href="https://www.google.com/maps/search/<%= visit.lokasi.mapsQuery %>" target="_blank" rel="noopener" class="btn btn--gold" style="margin-top: 1rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Buka di Google Maps
        </a>
      </div>
    </div>
  </section>

    <!-- ========== SAKRAMEN & KATEKISASI ========== -->
  <section class="section section--off-white" id="sakramen">
    <div class="container">
      <div class="section-header" data-aos="fade-up">
        <h2>Sakramen & <span class="text-gold">Katekisasi</span></h2>
        <span class="gold-line"></span>
        <p>Informasi mengenai sakramen kudus dan pembinaan iman jemaat di Gereja AMIN Hermon. Klik pada kartu untuk melihat jadwal dan keterangan lengkap.</p>
      </div>

      <div class="sakramen-grid" data-aos="fade-up">
        <% visit.sakramen.forEach(function(s, idx) { %>
        <div class="sakramen-card sakramen-card--interactive" onclick="openSakramenModal(<%= idx %>)" role="button" tabindex="0" aria-label="Lihat detail <%= s.nama %>" onkeydown="if(event.key==='Enter'||event.key===' ') openSakramenModal(<%= idx %>)">
          <div class="sakramen-card__nias-accent" aria-hidden="true"></div>
          <div class="sakramen-card__icon"><%= s.icon %></div>
          <h3><%= s.nama %></h3>
          <p><%= s.desc %></p>
          <div class="sakramen-card__hint">
            <span>Lihat Jadwal & Keterangan Lengkap</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ========== POPUP MODAL DETAIL SAKRAMEN & KATEKISASI ========== -->
  <div class="sakramen-modal" id="sakramenModal" role="dialog" aria-modal="true" aria-labelledby="sakramenModalTitle">
    <div class="sakramen-modal__backdrop" onclick="closeSakramenModal()"></div>
    <div class="sakramen-modal__content">
      <button type="button" class="sakramen-modal__close" onclick="closeSakramenModal()" aria-label="Tutup Detail">&times;</button>
      
      <!-- Traditional Nias Ornament Top Bar -->
      <div class="sakramen-modal__top-ribbon"></div>

      <div class="sakramen-modal__header">
        <div class="sakramen-modal__icon-wrap">
          <span id="sakramenModalIcon">🍷</span>
        </div>
        <div class="sakramen-modal__titles">
          <span class="sakramen-modal__badge">Pelayanan Gerejawi</span>
          <h3 id="sakramenModalTitle" class="sakramen-modal__title">Nama Sakramen</h3>
        </div>
      </div>

      <div class="sakramen-modal__body">
        <!-- Jadwal Box -->
        <div class="sakramen-modal__jadwal-box">
          <div class="sakramen-modal__jadwal-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          </div>
          <div>
            <h4 class="sakramen-modal__jadwal-heading">Jadwal & Waktu Pelaksanaan</h4>
            <p id="sakramenModalJadwal" class="sakramen-modal__jadwal-text">-</p>
          </div>
        </div>

        <!-- Penjelasan / Keterangan Lengkap -->
        <div class="sakramen-modal__detail-wrap">
          <h4 class="sakramen-modal__section-heading">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            Keterangan & Tata Laksana
          </h4>
          <div id="sakramenModalKeterangan" class="sakramen-modal__keterangan-text">
            <!-- Filled dynamically -->
          </div>
        </div>
      </div>

      <div class="sakramen-modal__footer">
        <a id="sakramenModalWaBtn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn--gold sakramen-modal__btn-wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.28-.1-.48-.15-.68.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.58-.5-.5-.68-.51-.18-.01-.38-.01-.58-.01s-.53.07-.8.38c-.28.3-1.06 1.03-1.06 2.52 0 1.49 1.08 2.92 1.23 3.12.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zm-5.42 7.4A9.87 9.87 0 0 1 7 20.14l-.36-.21-3.73.98.99-3.63-.24-.37a9.88 9.88 0 0 1-1.51-5.26c0-5.46 4.44-9.9 9.9-9.9 2.65 0 5.13 1.03 7 2.9a9.84 9.84 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9zm8.41-18.31A11.82 11.82 0 0 0 12.05.03C5.5.03.16 5.37.16 11.92c0 2.1.55 4.14 1.58 5.95L0 24l6.3-1.65a11.87 11.87 0 0 0 5.75 1.47c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41z"/></svg>
          Daftar / Konsultasi via WhatsApp
        </a>
        <button type="button" class="btn btn--outline" onclick="closeSakramenModal()">Tutup</button>
      </div>
    </div>
  </div>

  <script>
    const SAKRAMEN_LIST = <%- JSON.stringify(visit.sakramen) %>;
    const WA_NUMBER = "<%= (typeof contactFaq !== 'undefined' && contactFaq.whatsapp && contactFaq.whatsapp.number) ? contactFaq.whatsapp.number : '6281234567890' %>";

    function openSakramenModal(idx) {
      const item = SAKRAMEN_LIST[idx];
      if (!item) return;

      document.getElementById('sakramenModalIcon').textContent = item.icon || '✝️';
      document.getElementById('sakramenModalTitle').textContent = item.nama || '';
      document.getElementById('sakramenModalJadwal').textContent = item.jadwal || item.desc || 'Hubungi sekretariat gereja untuk informasi jadwal mendatang.';
      
      const ketEl = document.getElementById('sakramenModalKeterangan');
      const text = item.keterangan || item.desc || '';
      if (text.includes('\n')) {
        ketEl.innerHTML = text.split('\n\n').map(function(p) {
          return '<p style="margin-bottom:0.85rem; line-height:1.75;">' + p.replace(/\n/g, '<br>') + '</p>';
        }).join('');
      } else {
        ketEl.innerHTML = '<p style="line-height:1.75;">' + text + '</p>';
      }

      const waBtn = document.getElementById('sakramenModalWaBtn');
      const msg = encodeURIComponent('Halo Sekretariat Gereja AMIN Hermon, saya ingin bertanya dan mendapatkan informasi lebih lanjut mengenai ' + item.nama + '.');
      waBtn.href = 'https://wa.me/' + WA_NUMBER + '?text=' + msg;

      document.getElementById('sakramenModal').classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeSakramenModal() {
      const m = document.getElementById('sakramenModal');
      if (m) m.classList.remove('active');
      document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSakramenModal();
    });
  </script>

  <%- include('partials/footer') %>
  <script src="/js/main.min.js?v=21" defer></script>
</body>
</html>




